views {
 view c4_workspace_navigation of hpx.browser.ui.contents {
  title "C4 / Workspace and contents navigation — Implementation"
  description "Parent: Workspace and contents navigation. Actual markup/modules and source fragments; callbacks share app.js. Solid arrows are calls/control with labelled returns; dotted arrows are input/output data. External providers/callers/consumers remain outside. RuntimeAdapter owns captured requests/reconciliation; Rust owns authority/durability. No general workspace resolver or live History lens is invented."
  link https://github.com/dfdy/hypergraph-px/blob/d8d8c16f8923c0ff506d230c2de12037dcaf8d8c/docs/architecture/audits/workspace-navigation-c4-audit.md
  include user
  include hpx.browser.c4_protocol with { description "Existing RuntimeAdapter/initializeRuntime context: live catalog, exact client buffers, capabilities and guarded depart. API/recovery detail stays in linked views." navigateTo c4_api_routes }
  include hpx.browser.ui.contents.fixture_context
  include hpx.browser.editor.navigation_view with { navigateTo c3_browser_ui }
  include hpx.browser.shell.navigation_preferences
  include hpx.browser.shell.navigation_widths
  include hpx.browser.history.navigation_graph with { title "Current graph dialog • openRuntimeGraph" description "Existing capability-gated dialog implementation. Retained as current code evidence; the selected-node editor Graph tab is planned." navigateTo c3_browser_functions }
  include hpx.browser.ui.graph_tab with { navigateTo c3_browser_ui }
  include hpx.browser.shell.navigation_feedback
  include hpx.browser.ui.navigator with { navigateTo c3_browser_ui }
  group "Workspace and contents navigation" {
   group "Controls and outline rendering" {
    include hpx.browser.ui.contents.markup
    include hpx.browser.ui.contents.render
    include hpx.browser.ui.contents.headings
    include hpx.browser.ui.contents.tree
   }
   group "Navigation and editor following" {
    include hpx.browser.ui.contents.bindings
    include hpx.browser.ui.contents.activation
    include hpx.browser.ui.contents.follow
   }
  }
  style * { color primary }
  style element.tag = #planned { color muted; border dashed }
  exclude * -> *
  include * -> * where kind is navigation_call
  include * -> * where kind is navigation_data
  include hpx.browser.ui.contents.render -> hpx.browser.history.navigation_graph where kind is navigation_call with { title "Current: capability-gated graph dialog" }
  include hpx.browser.ui.contents.render -> hpx.browser.ui.graph_tab where kind is graph_tab_design
  autoLayout LeftRight 120 100 spline
 }
}
