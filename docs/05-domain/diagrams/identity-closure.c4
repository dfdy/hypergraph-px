// M1: one conceptual level below existing exact; not software decomposition or a record schema.
specification {
  element domain_concept { style { shape rectangle; color primary } }
  relationship conceptual_relation { color slate; line solid }
}
model {
  extend hpx.native.domain.exact {
    concept_node = domain_concept "Node" {
      description "Stable intellectual content identity."
      metadata { scope "conceptual only" source "HPX-SRC-0023:L9;HPX-CLAIM-00105" authority "inherited source-scoped design;not implementation" }
      link ../core-object-model.md#identity-and-representations
    }
    concept_revision = domain_concept "Revision" {
      description "Immutable content state of one logical node."
      metadata { scope "conceptual only" source "HPX-SRC-0023:L9;HPX-SRC-0025:L28-L33" }
      link ../provenance-model.md#revision-and-transformation-histories
    }
    concept_document = domain_concept "Document" {
      description "Named composition identity; not a plaintext file."
      metadata { scope "conceptual only" source "HPX-SRC-0023:L9;HPX-SRC-0037:L28-L37" }
      link ../document-semantics.md
    }
    concept_branch = domain_concept "Branch" {
      link ../../06-subsystems/contracts/editing-and-graph.md#main-branch-and-constructed-version-capture
      description "Independently identified evolving selection."
      metadata { scope "conceptual only" source "HPX-SRC-0023:L9" }
      link ../../04-architecture/decisions/0018-initial-local-branches.md
    }
    concept_occurrence = domain_concept "Occurrence" {
      link ../proposals/exact-closure-source-map.md#3-derived-finite-uses--choices1a3a
      description "Placement identity; reuse differs from content identity."
      metadata { scope "conceptual only" source "HPX-SRC-0023:L9;HPX-SRC-0025:L20-L27" }
      link ../document-semantics.md#identities-occurrences-and-temporal-state
    }
    concept_manifest = domain_concept "Manifest revision" {
      link ../proposals/cycle-boundary-source-emission.md#byte-ownership-and-frozen-inputs
      link ../proposals/cycle-boundary-source-emission.md#result-and-source-map-boundary
      link ../proposals/exact-closure-source-map.md#2-interpretation-evidence-not-a-policy-name-promise
      link ../proposals/exact-closure-source-map.md#4-one-typed-ordered-map--choice4a
      description "Immutable ordered structure and local prose."
      metadata { scope "conceptual only" source "HPX-SRC-0023:L9;HPX-SRC-0025:L20-L27" }
      link ../document-semantics.md#identities-occurrences-and-temporal-state
    }
    concept_snapshot = domain_concept "Closed snapshot" {
      link ../proposals/exact-closure-source-map.md#1-authoritative-bundle-and-representation-types
      description "Exact root, path-specific selections and reconstruction inputs."
      metadata { scope "conceptual only" source "HPX-SRC-0023:L9;HPX-SRC-0025:L34-L43" }
      link ../document-semantics.md#closed-snapshots-and-source-ownership
    }
  }
  hpx.native.domain.exact.concept_revision -[conceptual_relation]-> hpx.native.domain.exact.concept_node "State of exactly one same-node identity"
  hpx.native.domain.exact.concept_occurrence -[conceptual_relation]-> hpx.native.domain.exact.concept_node "References one logical content identity"
  hpx.native.domain.exact.concept_manifest -[conceptual_relation]-> hpx.native.domain.exact.concept_occurrence "Captures ordered placement structure"
  hpx.native.domain.exact.concept_document -[conceptual_relation]-> hpx.native.domain.exact.concept_manifest "Composition structure; exact historical state is pinned"
  hpx.native.domain.exact.concept_document -[conceptual_relation]-> hpx.native.domain.exact.concept_branch "Branch context; no general cardinality asserted"
  hpx.native.domain.exact.concept_snapshot -[conceptual_relation]-> hpx.native.domain.exact.concept_manifest "Pins exact root and reachable manifest selections"
  hpx.native.domain.exact.concept_snapshot -[conceptual_relation]-> hpx.native.domain.exact.concept_revision "Pins exact selections; never current heads"
  hpx.native.domain.exact.concept_snapshot -[conceptual_relation]-> hpx.native.domain.exact.concept_occurrence "Bindings use full occurrence context/path"
}
views {
  view concept_identity_closure of hpx.native.domain.exact {
    link ../../06-subsystems/contracts/editing-and-graph.md
    link ../proposals/reconstruction-correspondence.md
    title "Conceptual / Content identity and closed state"
    description "M1 / HPX-CAN-018. One-level conceptual restatement owned by existing Identity and exact-source coordinates; not modules, storage records or a complete resolver. Source-scoped definitions retain their authority; unspecified cardinalities remain unspecified. Every required reachable selection and reconstruction input must be closed; missing/inaccessible dependencies fail explicitly. Revision pin and descendant-closure pin differ. Equal bytes do not imply equal identity; move preserves placement identity; reuse creates another placement. Content-only edits do not duplicate every containing manifest history. OWNER055 specifies the bounded representation/format design and OWNER059 specifies the remaining working-state/main/capture lifecycle;actual codecs,resolver and correspondence remain unimplemented/unverified. OWNER059 D06–D09A: ordinary autosave remains mutable acknowledged recovery with exact retained dependencies;per-user drafts and expected-state shared publication retain explicit conflicts. Cadence alone creates no permanent history. Stable designated-main branch and atomic same-document constructed-version capture preserve exact selections,original receipts and existing immutable evidence. Relocation requires unique exact retained map evidence;stale/ambiguous anchors never quote-search. Current departure Commit remains."
    link ../../06-subsystems/diagrams/pure-domain.c4
    link ../core-object-model.md
    link ../document-semantics.md
    link ../../06-subsystems/interfaces/domain-navigation.md
    group "Conceptual subject: content identity and exact closed state" {
      include hpx.native.domain.exact.concept_node with { notes "HPX-OWNER-048 / HPX-RQ-039: creation of every node kind requires a known creation origin and a determinable parent or position from its initiating UI context or caret; missing or ambiguous context prevents creation, with no silently chosen position. Machine/shared-API requests carry explicit equivalent creation context, validated under ordinary backend permissions. Origin is not one permanent containment parent, original authorship, same-node revision ancestry or cross-identity derivation. Logical identity remains reusable through distinct occurrences. See [creation context contract](../../05-domain/core-object-model.md#creation-origin-and-placement--hpx-owner-048)." }
      include hpx.native.domain.exact.concept_revision
      include hpx.native.domain.exact.concept_document
      include hpx.native.domain.exact.concept_branch with { notes "HPX-OWNER-049 / HPX-RQ-041: offer save-as-branch for an authorised constructed version of the current document when it is not already represented as a specific branch, preserving exact composition selections and document/content identity rather than implicitly Forking. This capability does not require assuming an unnamed editable branch: ADR018/019 ordinary editing has an owning content branch; constituent selected branches/versions, working state and read-only projections differ. The owner's perhaps hypothesis about universal known branches remains an investigation, not adoption of a new lifecycle restriction or withdrawal of save-as. Main denotes an explicitly designated branch identity, not a name guess or latest-of-all-nodes graph algorithm. General capture/parentage, branch-capture publication and main designation/construction remain undesigned. See [branch reconciliation](../proposals/branch-selection-reconciliation.md)." }
      include hpx.native.domain.exact.concept_occurrence with { notes "In each resolved composition, every non-root occurrence has exactly one structural parent; roots have no structural parent. Sharing uses references to content, not multiple structural parents. The structural projection is an ordered rooted forest. OWNER048 requires a known creation origin and determinable parent or position, including a root's initiating position/context without inventing a structural parent. Later move/reuse does not turn creation origin into permanent containment; inline notation is not the definition of placement. LikeC4 disallows a type-to-itself relationship here, so this exact invariant remains explicit prose rather than an invalid self-arrow. OWNER053 accepts choices1A/2A: distinguish exact owned-source text ranges from graph-preserving composition selections. Composition membership follows exact structural contribution order and full occurrence/context; before B to after B selects B alone even when B and C share a parent-source byte cut. Crossing a zero-byte stopped inclusion selects its exact relationship/target/ancestor and separate warning/navigation without invented source bytes; identical structural start/end positions select nothing. Preserve exact partial source bytes with full occurrence/source context and distinguish a partial fragment from an entire selected inclusion. Clipped notation never becomes an executable whole inclusion. Do not silently expand selection or prohibit arbitrary owned-source ranges. These are accepted meanings, not a UI, endpoint codec, physical source map or mathematical/implementation correspondence proof; see [precise selection contract](../../05-domain/text-and-anchors.md#structural-membership-and-exact-partial-fragments--owner053)." }
      include hpx.native.domain.exact.concept_manifest
      include hpx.native.domain.exact.concept_snapshot with {
        notes "Retained example: D uses P at o1 and o2. s1 selects p1 at both; after p2 exists, s2 may select p2 at o1 and p1 at o2. Reading s1 still selects p1 twice. OWNER049 / RQ040: retained A shows its retained selected B version; a newer authorised version indication neither replaces that selection nor mutates history. OWNER050 clarifies reopening from A's last successful acknowledged autosave, retaining exact nested/repeated selections; unacknowledged typing is not claimed durable. Routine autosaving must not accumulate historical versions merely because it occurs. Whether autosave and Commit must always differ is reopened; current scoped ADR019/departure-Commit evidence remains historical and implemented, not a new universal future rule. No coalescing/deletion or mutable-history scheme is selected; current one-owned-buffer drafts do not prove general nested-selection recovery. OWNER052 accepts the logical distinction between ordinary acknowledged-composition recovery and an operation requiring immutable durable-reference evidence. Preserve exact selected unpublished source and nested context needed to reopen an acknowledged composition after constituent drafts advance; ordinary reopening retention does not itself create a permanent historical checkpoint, and repeated autosaves do not themselves create permanent captures. Existing immutable revisions/checkpoints/references remain intact. Recovery evidence is required state, not an evictable cache; another composition or unresolved operation must not lose its dependencies. This adopts no release/deletion, copying/deduplication/storage/format, general durable-reference event, save-as publication, permission or universal autosave/Commit rule. OWNER053 accepts selection meaning as stated in the occurrence note;endpoint representation and model/implementation correspondence remain undesigned. See [precise recovery scope](../../05-domain/document-semantics.md#recovery-purpose-and-immutable-reference-evidence--owner052). Repeated nested inclusions require distinct full paths, even when a manifest or node is shared. HPX-OWNER-043 adopts an explicit logical list of exact versions at every inclusion position, including exact cycle-boundary targets. First reconstruction guarantees identical source text and selected versions; appearance, font rendering and typesetting are external to that guarantee. OWNER045 selects a finite selected-state table and finite use tree with one-step structural row equality and exact cycle-target/active-ancestor witnesses; see [selected design](../proposals/finite-cycle-closure-state.md). Checked Lean model coverage and its source-emission/implementation limits are recorded in the [checked model scope](../../08-assurance/formal-validation-digest.md#finite-cycle-state-model--2026-10-31). OWNER047 retains exact original inclusion notation at a stopped cycle; warnings and deliberate navigation controls are separate presentation metadata, never generated placeholder source. The notation maps to its including owner and exact source range; target/ancestor context remains distinct. See [source-emission scope](../proposals/cycle-boundary-source-emission.md). OWNER051 accepts ordered structural contributions for reconstruction: a selected inclusion may have a known structural position/order without an authored textual marker. Expansion contributes its exact selected source at that saved structural position among owned source runs. At a stopped cycle with no original notation, contribute no invented authored text while retaining the exact stopped relationship, target/ancestor context and separate visible warning/deliberate navigation. If original notation exists, preserve its exact including-source bytes under OWNER047. No absence-of-marker inference may omit a structural inclusion or invent its position. This is an approved representational case, not current editor support or a universal encoding; persistent formats, subrange representation/correspondence, retention/capture mechanisms and permissions remain unresolved. The current supplied-notation Lean model does not prove no-notation boundary correspondence. TEST155 checks bounded emission and byte/source-map witnesses under supplied frozen source-faithful partitions; authenticated loading/parsing and runtime correspondence remain open. Physical encoding remains unadopted.  The item1 acquisition/validation definition is complete in the linked [input-preparation contract](../proposals/reconstruction-input-preparation.md#completed-supplier-result-contract): a complete admitted input must establish coherent historical or acknowledged-working intent, authenticated exact full-source/slice bindings, complete ordered structural contributions, occurrence-specific selected dependencies, endpoint/fragment membership and frozen interpretation together. Missing, denied, stale, contradictory or unsupported required evidence yields no complete input; a receipt, cached rendering, source length or caller-provided map alone cannot supply it. This is definition completion within existing accepted semantics, not implemented suppliers, a physical source map, operational profile or adapter/model/Rust proof. HPX-OWNER-054 accepts L1A/L2A operational policy: initially fail the requested complete reconstruction explicitly on limits, preserve the last valid view and exact frozen request context, and permit a separately explicit smaller-scope request or deliberate retry within supported limits. No silent clipping. Incomplete previews and incremental/streamed completion are deferred capabilities. Initial budgets are engineering-selected after concrete measurement, with clear failures and no user-facing tuning, privileged override, new administrator or unbounded bypass. Exhaustion is never a cycle witness, invalid saved content or history pruning. Each deliberate cycle navigation is one bounded exact-target action with no automatic background chain. Adequate budgets preserve successful exact selections, bytes and semantic cycle decisions. The linked [operational-limits design](../proposals/reconstruction-operational-limits.md) completes item2 specification: one operation allowance across acquisition, encrypted/decrypted bytes, decode/validation, real descriptor/table comparisons, repeated uses/slots, depth/path copying, emission, source-map/warning metadata and browser conversion/render admission; charge or reserve before work with checked arithmetic. Logical limits remain distinct from physical and aggregate safeguards. These accounting mechanisms are proposed engineering obligations, not implemented suppliers, measured capacities, persistent-profile changes or new proofs. HPX-OWNER-055 approves item3 choices1A/2A/3A/4A/6A/8A: retain the exact selected-state bundle as authority and derive the finite use tree on read; strictly tagged committed/checkpoint/retained-working source references; composition-local use references with parent/occurrence links and derived paths; one ordered typed map of exact copied-byte spans and explicit zero-byte structural/boundary/site entries; only reproducible validated map/tree caches are discardable; new explicitly versioned adapter records behind an explicit backed-up incompatible workspace upgrade and unsupported-reader refusal. Existing exact UTF8/full-source ranges, identified-buffer UTF16 conversion, supported byte-affecting interpretation evidence and cycle recurrence/target/ancestor semantics remain mandatory. [Concrete closure/source-map design](../proposals/exact-closure-source-map.md) specifies fields,algorithms,validation,costs and the effective compatibility gate against inspected current readers. This is approved representation/format design only;no actual schema or record version is changed,upgrade performed,format accepted for real data,or application/proof correspondence claimed. HPX-OWNER-056 approves item4 choices1A–7A: HPX-recorded Commit times have millisecond precision;ties and missing,unreliable or incomparable times Ask without backfilling or selection replacement. Explicit resolution may accept the selected version,choose an existing alternative,or retain an edited result under normal save/Commit rules;viewing/comparing never resolves and accepting an existing version need not create a content revision. Each conflict has its own identity and resolution;explicit batches name their members and regional summaries cannot clear unrelated issues. Carry unresolved issues only with exact source/selection correspondence;unrelated edits cannot silently drop them,uncertain correspondence is reported,and new competing selections create new issues. Historical views show current shared status for the exact version with accessible review history;any as-of status is separately labelled. Keep actual resolving workspace user,exact issue/outcome and optional explanation,without authorship inference. Ask default,per-user automatic opt-in,private drafts,cycle warnings and newer-version hints remain distinct. [Conflict-state design](../proposals/conflict-state.md) supplies concrete comparison/anchor/lifecycle/concurrency/recovery and versioned adapter layouts;this is design only,not implemented policy,codec/upgrade or proof correspondence. This is a conceptual definition, not a new record format or implementation."
      }
    }
    exclude * -> *
    include hpx.native.domain.exact.* -> hpx.native.domain.exact.* where kind is conceptual_relation
    autoLayout LeftRight 110 90 spline
  }
}
