views {
  view c3_pure_domain of hpx.native.domain {
    link ../../05-domain/diagrams/graph-projections.c4
    title "C3 / Pure domain"
    description "Focused source interpretation, not new Rust modules/services. Pure rules accept supplied inputs; adapters authenticate, load, allocate and publish. Expansion is not wired to runtime; partial parent-Merge foundations are not an integrated feature. Byte/occurrence/ancestry/derivation distinctions remain explicit. HPX-CAN-010 notes allocate required domain scope to five existing responsibilities; current helper coverage is separately bounded. Conceptual definitions and unresolved mechanisms stay in linked contracts; no conceptual gap is closed here."
    link https://github.com/dfdy/hypergraph-px/blob/d8d8c16f8923c0ff506d230c2de12037dcaf8d8c/docs/architecture/audits/pure-domain-audit.md
    link ../../05-domain/core-object-model.md
    link ../interfaces/domain-navigation.md
    link ../../05-domain/provenance-model.md
    link ../../04-architecture/decisions/0019-working-branches-and-reference-checkpoints.md
    group "Pure domain — no IO, authority or serialization" { color primary; border solid
      include hpx.native.domain.exact with { description "Typed IDs, historical anchors, exact ranges. No allocation, ownership or closure resolution." notes '''Required: distinct Node/Revision/Document/Branch/Occurrence/Manifest/Snapshot identities and exact UTF8 anchors; principal/session/permission and logical-ID/digest/address distinctions remain contract-defined. Current typed data/range helpers do not establish cardinalities, lifecycle, ownership or closure. No entropy, authorization, security-policy format or serialization. See linked Core Object Model and navigation contracts.

[Conceptual content identity and closed state](../Conceptual/identity-closure.c4)''' navigateTo c4_domain_sources }
      include hpx.native.domain.source_plans with { description "Pinned Fork/synthesis checks and private capture; plans do not grant authority or persist." notes '''Required: exact cross-identity input/output provenance, distinct from same-node parents; mutable draft acknowledgement versus Commit and adopted ADR019 private checkpoints remain separate. Current Fork/synthesis/capture helpers validate supplied context only; full transformations/interactions are not delivered. No authority, persistence or publication. See linked Core Object Model, provenance and ADR019.

[M3 provenance and working state](../Conceptual/provenance-working.c4)

[Conceptual retained-evidence effects](../Conceptual/evidence-effects.c4)''' navigateTo c4_domain_sources }
      include hpx.native.domain.annotation_rules with { description "Exact anchored comment/participant checks and judgement transitions; no truth inference." notes '''Required: revisioned n-ary hyperedges with ordered role-labelled participants, distinct predicates/assertions, and observable interaction/provenance distinctions. Current anchored comment, participant and judgement helpers cover a bounded subset; binary helpers do not restrict product arity or infer truth, authorship or permission. Full event/interaction records remain contract/design work. See linked Core Object Model and provenance contracts.

[M2 relationships and assertion context](../Conceptual/relationships.c4)''' navigateTo c4_domain_sources }
      include hpx.native.domain.history_plans with { description "Bounded DAG/base, trace/origin and selection helpers. Wider parent-Merge remains partial." notes "Required: immutable same-node ancestry distinct from cross-identity derivation, exact retained sources and closed historical reconstruction without current-head substitution. Current supplied-DAG/base/trace/origin helpers do not complete arbitrary history maps or publication. Event/Commit coordination and authority remain application responsibilities. See linked Core Object Model, provenance and navigation contracts." navigateTo c4_domain_history }
      include hpx.native.domain.expansion_rules with { description "Supplied expansion DAG only; no production caller, closure builder or reading-order result." notes "HPX-OWNER-041: cyclic inclusion relationships may be saved. Automatic expansion must stop at an explicit exact cycle boundary, show a warning and permit deliberate bounded click-through navigation without recursive auto-opening. Finite historical inclusion and repeated siblings remain valid; exact cycle detection is not a logical-ID-only or ever-growing-path test. Results retain every required expanded selection and cycle boundary; budgets never silently truncate a closed result. OWNER045 selects finite selected-state tables,structural row equality and finite use trees with exact target/ancestor witnesses. Checked pure Lean model results cover finite stopping,ordered exact-use coverage/determinism and warning/manual-navigation transitions for supplied finite typed tables; OWNER047 source emission now has 19 checked pure Lean theorems and18 synthetic guards under TEST155 for supplied frozen source-faithful partitions; operational resource bounds and Rust/UI/permission correspondence remain unproved. See [checked model scope](../../08-assurance/formal-validation-digest.md#finite-cycle-state-model--2026-10-31) for exact statements and limits. OWNER047 retains exact original inclusion notation at a stop and keeps generated warning/navigation controls outside authored bytes. Pure emission requires frozen source-faithful byte/range/slot inputs; source-map witnesses do not grant edit authority. See [source-emission scope](../proposals/cycle-boundary-source-emission.md). Current supplied-DAG validator still rejects cycles and does not implement this policy, closure or UI. Precise rules remain in the linked mathematics and formal contracts." navigateTo c4_domain_history }
    }
    group "Existing co-located caller responsibilities" { color primary; border solid
      include hpx.native.application with { title "Application coordination" description "Existing co-located adapter responsibility; see source-linked detail." navigateTo c3_application }
      include hpx.native.storage with { title "Workspace persistence" description "Existing co-located adapter responsibility; see source-linked detail." navigateTo c3_workspace_persistence }
    }
    style * { color primary }
    style element.tag = #planned { color muted; border dashed }
    exclude * -> *
    include hpx.native.application -> hpx.native.domain.source_plans where kind is domain_use
    include hpx.native.application -> hpx.native.domain.annotation_rules where kind is domain_use
    include hpx.native.storage -> hpx.native.domain.exact where kind is domain_use
    include hpx.native.storage -> hpx.native.domain.history_plans where kind is domain_use
    include hpx.native.domain.source_plans -> hpx.native.domain.exact where kind is domain_use
    include hpx.native.domain.annotation_rules -> hpx.native.domain.exact where kind is domain_use
    include hpx.native.domain.history_plans -> hpx.native.domain.exact where kind is domain_use
    exclude * -> * where kind is coverage_call
    exclude * -> * where kind is coverage_data
    exclude * -> * where kind is coverage_plan
    exclude * -> * where kind is delivery_detail_call
    exclude * -> * where kind is delivery_detail_data
    exclude * -> * where kind is delivery_detail_build
    exclude * -> * where kind is coordination_call
    exclude * -> * where kind is coordination_control
    exclude * -> * where kind is coordination_data
    exclude * -> * where kind is coordination_result
    autoLayout LeftRight 100 90 spline
  }
}
