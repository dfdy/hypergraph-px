// Canonical definition location: HPX-CAN-001/002 (HPX-OWNER-032). Existing design/implementation statuses retain their authority; see docs/architecture/SPECIFICATION.md.
specification {
  element person { style { shape person } }
  element system
  element browser { style { shape browser } }
  element workspace { style { shape storage } }
  relationship existing_flow { line solid }
}

model {
  user = person "Human users" {
    #partial
    description "Human users belong to one workspace; identity and permissions are not reusable across workspaces (HPX-OWNER-031). Multiple human users are mandatory in one deployment/workspace; owner is a role. Current development uses one owner and does not implement general multi-user authority. HPX-OWNER-027."
    link ../06-subsystems/ai-collaboration.md
    link ../01-purpose/README.md
  }

  ai_users = person "Machine users (workspace-local)" {
    #planned
    description "AI agents are a user kind. Provider-backed machine users share a workspace; at most one machine user per provider in each workspace; human and machine users belong to that workspace and are not reused elsewhere; chat prompts/context/responses are nodes and selected-node MCP edits use human-equivalent application semantics. Machine users provide chat and act through MCP; model inference runs on their side, not as an HPX service (HPX-OWNER-033). Required baseline;unimplemented,not federation."
    link ../06-subsystems/ai-collaboration.md
  }

  hpx = system "Hypergraph PX" {
    description "A local writing and thinking environment for identifiable, reusable, versioned contributions and explicit relationships. Canonical location for system/container structure (HPX-CAN-001); remaining V3 proposals keep their status and implementation remains evidence."
    link ../01-purpose/README.md
    link ../04-architecture/system-architecture.md

    browser = browser "Browser interface" {
      technology "HTML / CSS / JavaScript; CodeMirror / KaTeX"
      description "Editor and navigation running in the owner's browser. Frontend assets are delivered by the native executable. Launch/session authorization is distinct from passphrase or explicit keychain unlock; workspace keys remain Rust-only. Browser hostname verification and explicitly approved OS/browser certificate trust are required; certificate errors never permit HTTP fallback. Future browser-only and independently trusted client delivery paths remain gated, with no additional client implementation selected."
      link ../06-subsystems/frontend-interaction.md
      link ../04-architecture/decisions/0004-local-https-bootstrap.md
      link ../06-subsystems/security-cryptography.md
    }

    workspace = workspace "Encrypted .hpx workspace" {
      technology "SQLite file; authenticated encrypted records"
      description "Authoritative local .hpx SQLite file, with WAL/SHM recovery files while open. Retains encrypted content, history, drafts, heads and receipts; clear bootstrap and structural metadata remain visible. SQLite runs inside the Rust executable. Private provenance clipboard, acknowledged drafts, required application/recovery evidence and retained history belong in this portable workspace. WAL is recovery machinery, not application history. No external registration or rollback witness is required (HPX-OWNER-009)."
      link ../04-architecture/data-architecture.md
      link ../06-subsystems/formats/hpx-workspace.md
    }
  }

  credentials = system "Operating-system credential store" {
    technology "Native OS keychain; current adapter: macOS"
    description "Optional native keychain for explicitly enrolled workspace unlock. Passphrase unlock and recovery remain available. Current native adapter supports macOS."
    link ../04-architecture/decisions/0014-keychain-unlock-policy.md
  }

  user -[existing_flow]-> hpx.browser "Writes, explores and reviews" {
    link ../../frontend/src/app.js
  }
  hpx.browser -[existing_flow]-> hpx.native.transport.https "Authenticated loopback HTTPS API" {
    link ../06-subsystems/interfaces/browser-runtime.md
  }
  hpx.native.frontend_assets -[existing_flow]-> hpx.browser "Delivers embedded frontend assets" {
    link ../../backend/crates/runtime/build.rs
  }
  hpx.native.storage -[existing_flow]-> hpx.workspace "Reads and publishes encrypted workspace state" {
    link ../../backend/crates/storage/src/lib.rs
  }
  hpx.native.keychain -[existing_flow]-> credentials "Optional explicit credential operations" {
    link ../../backend/crates/keychain/src/lib.rs
  }
}

views {
  view index {
    title "C1 / System context"
    link ./audits/dom001-c1-migration.md
    description "HPX as one software system, human/AI users and specified external systems. Solid connections describe the bounded existing local slice; dashed boxes and connections are planned or future scope. File exchange is part of the owner's interaction; files, containers and implementation details are omitted at C1. Structural definitions are canonical under HPX-CAN-001/002; unadopted designs remain proposed. Multi-user/AI-user support is mandatory;solid edges retain prototype evidence and planned edges do not imply delivery. Federation is separate. Click HPX for C2."
    include user with { description "Human users write, explore and review HPX content. Users are workspace-local; multiple users are required. Display names are mutable labels, not identity or permission. Current one-owner development is incomplete product coverage." }
    include ai_users with { description "Workspace-local machine users use chat and MCP; one per provider. Display names are labels, not identity or permission. Chat nodes and ordinary graph/history rules are required; execution planned. Inference stays outside HPX." }
    include credentials
    include hpx with { navigateTo c2_containers description "Identifiable, reusable, versioned content and relationships. Presents derived views; records attributable human/machine exchanges separately from contributions. Required semantics; implementation partial. Open C2 for container boundaries." }
    // Presentation grouping only, not a shared deployment or trust boundary.
    group "Future integrations" {
      color muted
      border dashed
      include zotero, github, peers
    }
    style element.tag = #planned {
      color muted
      border dashed
    }
    // Use the model's existing relationships, projected to the whole HPX system.
    include user -> hpx with { title "Writes, explores and reviews" }
    include ai_users -> hpx with { title "Required chat nodes / selected-node MCP" }
    include hpx -> credentials with { title "Optional keychain unlock" }
    include hpx -> zotero with { title "Read-only citations" }
    include hpx -> github with { title "Releases / publication / backup" }
    include hpx -> peers with { title "Future federation / exchange" }
    rank source { user, ai_users }
    exclude * -> * where kind is code_call
    exclude * -> * where kind is delivery_build
    exclude * -> * where kind is delivery_call
    exclude * -> * where kind is delivery_code
    exclude * -> * where kind is domain_use
    exclude * -> * where kind is domain_call
    exclude * -> * where kind is domain_type
    exclude * -> * where kind is domain_test
    exclude * -> * where kind is coverage_call
    exclude * -> * where kind is coverage_data
    exclude * -> * where kind is coverage_plan
    exclude * -> * where kind is delivery_detail_call
    exclude * -> * where kind is delivery_detail_data
    exclude * -> * where kind is delivery_detail_build
    exclude * -> * where kind is coordination_call
    exclude * -> * where kind is coordination_control
    exclude * -> * where kind is coordination_data
    exclude * -> * where kind is coordination_result
    exclude * -> * where kind is browser_detail
    exclude * -> * where kind is browser_organisation
    exclude * -> * where kind is browser_presentation
    exclude * -> * where kind is navigation_call
    exclude * -> * where kind is navigation_data
    exclude * -> * where kind is graph_tab_design
    // DOM001 C1 output: project an existing browser presentation flow; no new model relationship or container.
    include hpx -> user where kind is browser_organisation with { title "Derived views / results" description "A View is a derived presentation of content, not another canonical content identity or storage engine. Permission checks still apply; detailed object/projection semantics remain in HPX-DOM-001." }
    autoLayout LeftRight 100 65 spline
  }
}
