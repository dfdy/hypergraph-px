// Supporting operation effects of existing publication;not implementation calls or wire ordering.
views {
  dynamic view seq_concept_publication {
    variant sequence
    title "Conceptual effects / Draft acknowledgement and Commit"
    description "O1 / HPX-CAN-022. Source-backed effects on conceptual lifelines,not software calls,SQL order or a transaction protocol. Current authority and complete exact source/state preconditions are required before publication. The Commit branch describes one atomic effect set;there is no externally visible intermediate revision/snapshot/head state. Accepted trigger policy remains in linked contracts;this view adds no automatic Commit trigger or endpoint."
    link ../C3/remaining-c3.c4
    link ../../07-implementation/protocols/draft-publication.md
    link ../../08-assurance/recovery.md
    alt "Distinct operations and outcomes" {
      when "Save/acknowledge exact owned draft" {
        hpx.native.domain.source_plans.concept_draft -> hpx.native.domain.source_plans.concept_draft "Acknowledge captured generation/base/through-sequence;mutable recoverable state only"
        hpx.native.domain.source_plans.concept_draft -> hpx.native.domain.source_plans.concept_draft "Retain typing after captured sequence;no immutable revision,snapshot or Commit created"
      }
      when "Authorised Commit of exact captured state" {
        hpx.native.domain.source_plans.concept_draft -> hpx.native.domain.source_plans.concept_commit "Check exact expected state/current authority;do not silently include newer typing"
        hpx.native.domain.source_plans.concept_commit -> hpx.native.domain.exact.concept_revision "Atomic effect:new immutable same-node revision with exact same-identity parent"
        hpx.native.domain.source_plans.concept_commit -> hpx.native.domain.exact.concept_snapshot "Atomic effect:complete exact closed snapshot and reconstruction bindings"
        hpx.native.domain.source_plans.concept_commit -> hpx.native.domain.exact.concept_branch "Atomic effect:advance selected published head under exact preconditions"
        hpx.native.domain.source_plans.concept_commit -> hpx.native.domain.source_plans.concept_event "Atomic effect:attributable semantic event and original-operation receipt"
        hpx.native.domain.source_plans.concept_commit -> hpx.native.domain.source_plans.concept_draft "Atomic effect:rebase acknowledged draft;preserve newer local typing"
        hpx.native.domain.source_plans.concept_commit -> hpx.native.domain.source_plans.concept_commit "Complete result/head/draft/event/receipt publish together or not at all;retain prior history"
      }
      else "Delayed,lost or uncertain acknowledgement" {
        hpx.native.domain.source_plans.concept_draft -> hpx.native.domain.source_plans.concept_commit "Reconcile original frozen operation/current authority;timeout proves neither success nor safe fresh mutation"
        hpx.native.domain.source_plans.concept_commit -> hpx.native.domain.source_plans.concept_draft "Return authorised original outcome or explicit denial/conflict/uncertainty;never substitute newer state"
      }
    }
  }
}
