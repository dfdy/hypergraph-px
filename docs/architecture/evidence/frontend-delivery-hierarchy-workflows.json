                      "_type": "alt-else",
                      "id": "step-02:alt.04:else.02:alt.02:else",
                      "title": "Allowed static request"
                    }
                  ],
                  "_type": "alt",
                  "id": "step-02:alt.04:else.02:alt",
                  "title": "Host and cross-site checks"
                }
              ],
              "_type": "alt-else",
              "id": "step-02:alt.04:else",
              "title": "TLS/framing, state lock and deadline allow routing"
