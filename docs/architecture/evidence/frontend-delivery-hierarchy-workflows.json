          "_type": "alt",
          "id": "step-02:alt",
          "title": "TLS and request framing"
        }
      ],
      "messages": [
        {
          "id": "step-01",
          "source": "hpx.browser",
          "target": "hpx.native.transport.https",
          "label": "Request initial page / static resources \nover trusted loopback TLS"
        },
        {
          "id": "step-02:alt.01:when.01",
          "source": "hpx.browser",
          "target": "hpx.browser",
          "label": "Stop connection; no warning bypass or \nplaintext fallback"
        },
        {
          "id": "step-02:alt.02:when.01",
          "source": "hpx.native.transport.https",
          "target": "hpx.native.transport.responses.delivery_writer",
          "label": "Write bounded invalid-HTTP response"
        },
        {
          "id": "step-02:alt.02:when.02",
          "source": "hpx.native.transport.https",
          "target": "hpx.browser",
          "label": "Attempt safe error; IO failure may \nprevent delivery; no resource selected"
        },
        {
          "id": "step-02:alt.03:when.01",
          "source": "hpx.native.transport.https",
          "target": "hpx.native.transport.responses.delivery_writer",
          "label": "Attempt 503 unavailable or 408 request \ntimeout; route not invoked"
        },
        {
          "id": "step-02:alt.03:when.02",
          "source": "hpx.native.transport.https",
          "target": "hpx.browser",
          "label": "Safe error only if TLS writing/delivery \ncompletes"
        },
        {
          "id": "step-02:alt.04:else.01",
          "source": "hpx.native.transport.https",
          "target": "hpx.native.transport.security.c4_gates",
          "label": "Parsed non-API GET"
        },
        {
          "id": "step-02:alt.04:else.02:alt.01:when.01",
          "source": "hpx.native.transport.security.c4_gates",
          "target": "hpx.native.transport.https",
          "label": "Safe rejection"
        },
        {
          "id": "step-02:alt.04:else.02:alt.01:when.02",
          "source": "hpx.native.transport.https",
          "target": "hpx.native.transport.responses.delivery_writer",
          "label": "Write shared security headers/error"
        },
        {
          "id": "step-02:alt.04:else.02:alt.01:when.03",
          "source": "hpx.native.transport.https",
          "target": "hpx.browser",
          "label": "Attempt rejection response; IO failure \nmay prevent delivery"
        },
        {
          "id": "step-02:alt.04:else.02:alt.02:else.01",
          "source": "hpx.native.transport.security.c4_gates",
          "target": "hpx.native.transport.assets.delivery_lookup",
          "label": "Branch before session/bootstrap/unlock \nguards"
        },
        {
          "id": "step-02:alt.04:else.02:alt.02:else.02",
          "source": "hpx.native.transport.assets.delivery_lookup",
          "target": "hpx.native.transport.assets.delivery_lookup",
          "label": "Root aliases index.html; otherwise exact \nembedded key"
        },
        {
          "id": "step-02:alt.04:else.02:alt.02:else.03:alt.01:when.01",
          "source": "hpx.native.transport.assets.delivery_lookup",
          "target": "hpx.native.frontend_assets.resources.map_code",
          "label": "Read compiled ASSETS bytes"
        },
        {
          "id": "step-02:alt.04:else.02:alt.02:else.03:alt.01:when.02",
          "source": "hpx.native.frontend_assets.resources.map_code",
          "target": "hpx.native.transport.assets.delivery_lookup",
          "label": "Bytes already inside executable"
        },
        {
          "id": "step-02:alt.04:else.02:alt.02:else.03:alt.01:when.03",
          "source": "hpx.native.transport.assets.delivery_lookup",
          "target": "hpx.native.transport.security.c4_gates",
          "label": "MIME/body descriptor; no cookie"
        },
        {
          "id": "step-02:alt.04:else.02:alt.02:else.03:alt.02:else.01",
          "source": "hpx.native.transport.assets.delivery_lookup",
          "target": "hpx.native.transport.security.c4_gates",
          "label": "404; never filesystem fallback"
        },
        {
          "id": "step-02:alt.04:else.02:alt.02:else.04",
          "source": "hpx.native.transport.security.c4_gates",
          "target": "hpx.native.transport.https",
          "label": "Static Response"
        },
        {
          "id": "step-02:alt.04:else.02:alt.02:else.05",
          "source": "hpx.native.transport.https",
          "target": "hpx.native.transport.responses.delivery_writer",
          "label": "Length, no-store/CSP/nosniff/referrer \npolicy, body and close"
        },
        {
          "id": "step-02:alt.04:else.02:alt.02:else.06:alt.01:when.01",
          "source": "hpx.native.transport.responses.delivery_writer",
          "target": "hpx.native.transport.https",
          "label": "Ok: local stream accepted writes; no \nbrowser receipt"
