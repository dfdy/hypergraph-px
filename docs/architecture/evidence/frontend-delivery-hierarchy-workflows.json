    "seq_frontend_load": {
      "title": "Sequence / Load browser interface",
      "flow": [
        "step-01",
        {
          "flow": [
            {
              "flow": [
                "step-02:alt.01:when.01"
              ],
              "_type": "alt-when",
              "id": "step-02:alt.01:when",
              "title": "Certificate/hostname/trust fails"
            },
            {
              "flow": [
                "step-02:alt.02:when.01",
                "step-02:alt.02:when.02"
              ],
              "_type": "alt-when",
              "id": "step-02:alt.02:when",
              "title": "TLS valid but HTTP framing invalid"
            },
            {
              "flow": [
                "step-02:alt.03:when.01",
                "step-02:alt.03:when.02"
              ],
              "_type": "alt-when",
              "id": "step-02:alt.03:when",
              "title": "TLS/framing valid; state mutex poisoned or deadline elapsed after lock"
            },
            {
              "flow": [
                "step-02:alt.04:else.01",
                {
                  "flow": [
                    {
                      "flow": [
                        "step-02:alt.04:else.02:alt.01:when.01",
                        "step-02:alt.04:else.02:alt.01:when.02",
                        "step-02:alt.04:else.02:alt.01:when.03"
                      ],
                      "_type": "alt-when",
                      "id": "step-02:alt.04:else.02:alt.01:when",
                      "title": "Rejected"
                    },
                    {
                      "flow": [
                        "step-02:alt.04:else.02:alt.02:else.01",
                        "step-02:alt.04:else.02:alt.02:else.02",
                        {
                          "flow": [
                            {
                              "flow": [
                                "step-02:alt.04:else.02:alt.02:else.03:alt.01:when.01",
                                "step-02:alt.04:else.02:alt.02:else.03:alt.01:when.02",
                                "step-02:alt.04:else.02:alt.02:else.03:alt.01:when.03"
                              ],
                              "_type": "alt-when",
                              "id": "step-02:alt.04:else.02:alt.02:else.03:alt.01:when",
                              "title": "Key exists"
                            },
                            {
                              "flow": [
                                "step-02:alt.04:else.02:alt.02:else.03:alt.02:else.01"
                              ],
                              "_type": "alt-else",
                              "id": "step-02:alt.04:else.02:alt.02:else.03:alt.02:else",
                              "title": "Unknown key"
                            }
                          ],
                          "_type": "alt",
                          "id": "step-02:alt.04:else.02:alt.02:else.03:alt",
                          "title": "Map lookup"
                        },
                        "step-02:alt.04:else.02:alt.02:else.04",
                        "step-02:alt.04:else.02:alt.02:else.05",
                        {
                          "flow": [
                            {
                              "flow": [
                                "step-02:alt.04:else.02:alt.02:else.06:alt.01:when.01",
                                "step-02:alt.04:else.02:alt.02:else.06:alt.01:when.02"
                              ],
                              "_type": "alt-when",
                              "id": "step-02:alt.04:else.02:alt.02:else.06:alt.01:when",
                              "title": "Writes and flush succeed locally"
                            },
                            {
                              "flow": [
                                "step-02:alt.04:else.02:alt.02:else.06:alt.02:else.01",
                                "step-02:alt.04:else.02:alt.02:else.06:alt.02:else.02"
                              ],
                              "_type": "alt-else",
                              "id": "step-02:alt.04:else.02:alt.02:else.06:alt.02:else",
                              "title": "Write or flush IO failure"
                            }
                          ],
                          "_type": "alt",
                          "id": "step-02:alt.04:else.02:alt.02:else.06:alt",
                          "title": "Writer result (ignored by serve_socket)"
