views {
  dynamic view seq_frontend_build {
    variant sequence
    title "Sequence / Frontend delivery — Build and embed assets"
    description "Descriptive build/development workflow only; no build is run in this task. Node produces a verified snapshot/dist; a separately invoked Rust build embeds it. Cache validity is not test/release acceptance. Dist copying is not atomic; Rust does not independently prove source freshness or closure."
    link ../../../frontend/build.mjs
    link ../../../frontend/scripts/build-cache.mjs
    link ../../../backend/crates/runtime/build.rs
    frontend_builder.bundle_code -> frontend_builder.cache_code "cachedBuild: identify source, installed inputs and Node/platform/arch"
    alt "Snapshot cache" {
      when "Source identity and output digest validate" {
    frontend_builder.bundle_code <- frontend_builder.cache_code "Reuse verified snapshot directory"
      }
      else "Cache missing or invalid" {
    frontend_builder.cache_code -> frontend_builder.bundle_code "Invoke build callback into temporary assets directory"
    frontend_builder.bundle_code -> frontend_builder.bundle_code "esbuild ESM; copy HTML/CSS/logo/fonts; notices/LICENSE; preview version"
        alt "Build and input recheck" {
          when "Callback succeeds and input identity unchanged" {
    frontend_builder.cache_code <- frontend_builder.bundle_code "Candidate static output"
    frontend_builder.cache_code -> frontend_builder.cache_code "Hash output; write manifest; rename snapshot; validate competing entry"
    frontend_builder.bundle_code <- frontend_builder.cache_code "Verified snapshot result"
          }
          else "Build error or changed inputs" {
            break "Build call fails" {
    frontend_builder.cache_code -> frontend_builder.cache_code "Remove temporary tree; no valid snapshot published"
    frontend_builder.bundle_code <- frontend_builder.cache_code "Error; do not claim prepared output"
            }
          }
        }
      }
    }
    opt "Default snapshotOnly=false" {
    frontend_builder.bundle_code -> frontend_builder.cache_code "installDist(snapshot)"
      alt "Current dist digest" {
        when "Already matches" {
    frontend_builder.bundle_code <- frontend_builder.cache_code "Skip rewrite"
        }
        else "Replacement required" {
    frontend_builder.cache_code -> frontend_dist "Acquire dist lock; remove/copy tree; verify output digest"
          alt "Installation result" {
            when "Digest matches" {
    frontend_builder.bundle_code <- frontend_builder.cache_code "Prepared dist; release lock"
            }
            else "Lock/copy/verification error" {
              break "Build call fails; no atomic dist guarantee" {
    frontend_builder.bundle_code <- frontend_builder.cache_code "Report failure; partial dist may remain"
              }
            }
          }
        }
      }
    }
    opt "A separate explicit Rust build is invoked" {
    hpx.native.frontend_assets.embedding.build_code -> hpx.native.frontend_assets.embedding.build_code "Attempt counter lock/append and OUT_DIR compiled-version generation"
      alt "Build identity IO" {
        when "Counter and version generation succeed" {
    hpx.native.frontend_assets.embedding.build_code -> frontend_dist "Require index.html; sorted walk; reject symlinks"
      alt "Prepared tree / IO validity" {
        when "Inputs accepted by existing build script" {
    hpx.native.frontend_assets.embedding.build_code -> hpx.native.frontend_assets.embedding.build_code "Emit include_bytes entries; skip dist version and append compiled-version route"
    hpx.native.frontend_assets.embedding.build_code -> hpx.native.frontend_assets.resources.map_code "Write assets.rs; main.rs include! compiles byte references"
        }
        else "Missing index, symlink or IO/compiler failure" {
    hpx.native.frontend_assets.embedding.build_code -> hpx.native.frontend_assets.embedding.build_code "Build fails; may consume counter value; no new valid executable claim"
        }
      }
        }
        else "Counter/version IO failure" {
    hpx.native.frontend_assets.embedding.build_code -> hpx.native.frontend_assets.embedding.build_code "Abort before asset-map generation; counter may already be consumed"
        }
      }
    }
    style * { color primary }
    style element.tag = #planned { color muted; border dashed }
    include frontend_builder.bundle_code with { navigateTo c4_frontend_build }
    include frontend_builder.cache_code with { navigateTo c4_frontend_build }
    include frontend_dist with { navigateTo c4_frontend_embedding }
    include hpx.native.frontend_assets.embedding.build_code with { navigateTo c4_frontend_embedding }
    include hpx.native.frontend_assets.resources.map_code with { navigateTo c4_frontend_embedding }
  }
  dynamic view seq_frontend_load {
    variant sequence
    title "Sequence / Frontend delivery — Load browser interface"
    description "Browser loading from the single runtime executable. TLS/framing/Host/site checks still apply. Static assets require neither session nor workspace unlock. Return flow passes through the real shared response writer; write/flush IO errors are ignored by serve_socket, so writing is not delivery acknowledgement. No arbitrary disk serving or HTTP fallback. Browser editing/navigation are separate from delivery."
    link ../../04-architecture/decisions/0004-local-https-bootstrap.md
    link ../../../backend/crates/runtime/src/main.rs
    link ../../../frontend/index.html
    link ../../../frontend/src/app.js
    hpx.browser -> hpx.native.transport.https "Request initial page / static resources over trusted loopback TLS"
    alt "TLS and request framing" {
      when "Certificate/hostname/trust fails" {
    hpx.browser -> hpx.browser "Stop connection; no warning bypass or plaintext fallback"
      }
      when "TLS valid but HTTP framing invalid" {
    hpx.native.transport.https -> hpx.native.transport.responses.delivery_writer "Write bounded invalid-HTTP response"
    hpx.browser <- hpx.native.transport.https "Attempt safe error; IO failure may prevent delivery; no resource selected"
      }
      when "TLS/framing valid; state mutex poisoned or deadline elapsed after lock" {
    hpx.native.transport.https -> hpx.native.transport.responses.delivery_writer "Attempt 503 unavailable or 408 request timeout; route not invoked"
    hpx.browser <- hpx.native.transport.https "Safe error only if TLS writing/delivery completes"
      }
      else "TLS/framing, state lock and deadline allow routing" {
    hpx.native.transport.https -> hpx.native.transport.security.c4_gates "Parsed non-API GET"
        alt "Host and cross-site checks" {
          when "Rejected" {
    hpx.native.transport.https <- hpx.native.transport.security.c4_gates "Safe rejection"
    hpx.native.transport.https -> hpx.native.transport.responses.delivery_writer "Write shared security headers/error"
    hpx.browser <- hpx.native.transport.https "Attempt rejection response; IO failure may prevent delivery"
          }
          else "Allowed static request" {
    hpx.native.transport.security.c4_gates -> hpx.native.transport.assets.delivery_lookup "Branch before session/bootstrap/unlock guards"
    hpx.native.transport.assets.delivery_lookup -> hpx.native.transport.assets.delivery_lookup "Root aliases index.html; otherwise exact embedded key"
            alt "Map lookup" {
              when "Key exists" {
    hpx.native.transport.assets.delivery_lookup -> hpx.native.frontend_assets.resources.map_code "Read compiled ASSETS bytes"
    hpx.native.transport.assets.delivery_lookup <- hpx.native.frontend_assets.resources.map_code "Bytes already inside executable"
    hpx.native.transport.security.c4_gates <- hpx.native.transport.assets.delivery_lookup "MIME/body descriptor; no cookie"
              }
              else "Unknown key" {
    hpx.native.transport.security.c4_gates <- hpx.native.transport.assets.delivery_lookup "404; never filesystem fallback"
              }
            }
    hpx.native.transport.https <- hpx.native.transport.security.c4_gates "Static Response"
    hpx.native.transport.https -> hpx.native.transport.responses.delivery_writer "Length, no-store/CSP/nosniff/referrer policy, body and close"
            alt "Writer result (ignored by serve_socket)" {
              when "Writes and flush succeed locally" {
    hpx.native.transport.https <- hpx.native.transport.responses.delivery_writer "Ok: local stream accepted writes; no browser receipt"
    hpx.browser <- hpx.native.transport.https "Asset bytes or safe error if network delivery completes"
              }
              else "Write or flush IO failure" {
    hpx.native.transport.https <- hpx.native.transport.responses.delivery_writer "Err: caller ignores result; no server retry"
    hpx.browser -> hpx.browser "Resource may be absent or partial; loading not guaranteed"
              }
            }
            opt "Required resources successfully loaded" {
    hpx.browser -> hpx.browser "Evaluate app module and bundled dependencies in browser"
    hpx.browser -> hpx.browser "Start best-effort version display; await initializeRuntime" { navigateTo seq_frontend_session }
            }
          }
        }
      }
    }
    style * { color primary }
    style element.tag = #planned { color muted; border dashed }
    include hpx.browser with { navigateTo c3_frontend_delivery }
    include hpx.native.frontend_assets.resources.map_code with { navigateTo c4_frontend_embedding }
    include hpx.native.transport.assets.delivery_lookup with { navigateTo c4_frontend_routing }
    include hpx.native.transport.https with { navigateTo c3_runtime_api }
    include hpx.native.transport.responses.delivery_writer with { navigateTo c4_frontend_routing }
    include hpx.native.transport.security.c4_gates with { navigateTo c4_frontend_routing }
  }
  dynamic view seq_frontend_session {
    variant sequence
    title "Sequence / Frontend delivery — Establish launch session"
    description "Asset loading is not session authentication; session authentication is not workspace unlock or resource authority. Optional fragment exchange precedes metadata. Fragment removal precedes exchange; missing/unusable replies have no automatic bootstrap retry or session reconciliation; the unavailable overlay directs the owner to the private launch URL. HTTPS initialization failure rethrows and blocks live startup; non-HTTPS fixture preview is a deliberate separate mode. Unlock and command recovery remain separate existing workflows."
    link ../../../frontend/src/app.js
    link ../../../frontend/src/runtime-adapter.js
    link ../../../frontend/src/api-client.ts
    link ../../../backend/crates/runtime/src/main.rs
    link ../../04-architecture/decisions/0004-local-https-bootstrap.md
    hpx.browser.delivery_entry -> hpx.browser.c4_protocol "Await initializeRuntime"
    alt "Delivery mode" {
      when "Non-HTTPS synthetic preview" {
    hpx.browser.delivery_entry <- hpx.browser.c4_protocol "Return null for explicit fixture mode; not a release transport fallback"
      }
      else "HTTPS runtime path" {
        opt "Launch fragment present" {
    hpx.browser.c4_protocol -> hpx.browser.c4_protocol "Read launch capability; history.replaceState removes fragment before POST"
    hpx.browser.c4_protocol -> hpx.native.transport.security.c4_gates "Same-origin JSON bootstrap request"
          alt "Bootstrap exchange observation" {
            when "Request/reply completes" {
    hpx.native.transport.security.c4_gates -> hpx.native.transport.security.c4_bootstrap "Bootstrap exception: no session cookie prerequisite"
    hpx.native.transport.security.c4_bootstrap -> hpx.native.transport.security.c4_compare "secure_equal launch capability"
          alt "Capability" {
            when "Match" {
    hpx.native.transport.security.c4_bootstrap <- hpx.native.transport.security.c4_compare "Valid launch capability"
    hpx.browser.c4_protocol <- hpx.native.transport.security.c4_bootstrap "Set distinct process-lifetime Secure/HttpOnly/SameSite host cookie"
            }
            else "Mismatch" {
              break "Initialization rejects; no fallback" {
    hpx.browser.c4_protocol <- hpx.native.transport.security.c4_bootstrap "Unauthorized"
    hpx.browser.delivery_entry <- hpx.browser.c4_protocol "Reject initialization; leave unavailable overlay"
              }
            }
          }
            }
            else "Fetch or reply-processing failure; server outcome may be unknown" {
              break "HTTPS startup rejects" {
    hpx.browser.c4_protocol -> hpx.browser.c4_protocol "Fragment removed; no automatic bootstrap retry; prompt reopen private launch URL"
    hpx.browser.delivery_entry <- hpx.browser.c4_protocol "Throw; show unavailable overlay; no fixture fallback"
              }
            }
          }
        }
    hpx.browser.c4_protocol -> hpx.native.transport.security.c4_gates "Request runtime metadata with current cookie"
        alt "Runtime metadata observation" {
          when "Fetch or reply-processing failure" {
    hpx.browser.delivery_entry <- hpx.browser.c4_protocol "Throw; show unavailable overlay; no live or fixture startup"
          }
          when "Missing or invalid cookie" {
    hpx.browser.c4_protocol <- hpx.native.transport.security.c4_gates "Unauthorized"
    hpx.browser.delivery_entry <- hpx.browser.c4_protocol "Throw; do not select fixture documents after HTTPS failure"
          }
          else "Valid session" {
    hpx.native.transport.security.c4_gates -> hpx.native.transport.lifecycle.c4_lifecycle "Construct runtime metadata; may remain locked"
    hpx.browser.c4_protocol <- hpx.native.transport.lifecycle.c4_lifecycle "Contract/mode/ownership + capabilities + locked/create/platform status; no keys"
    hpx.browser.c4_protocol -> hpx.browser.c4_protocol "Check contract/mode/ownership after receiving metadata"
            alt "Browser runtime compatibility" {
              when "Unsupported contract, mode or ownership" {
    hpx.browser.delivery_entry <- hpx.browser.c4_protocol "Reject initialization; show unavailable overlay; no fixture fallback"
              }
              else "Supported API1 / trusted_server / whole_document" {
                alt "Workspace state" {
                  when "Locked" {
    hpx.browser.c4_protocol -> hpx.browser.c4_protocol "Prompt explicit create/passphrase or enrolled keychain choice; wait for successful unlock" { navigateTo seq_unlock }
                  }
                  else "Already unlocked" {
    hpx.browser.c4_protocol -> hpx.browser.c4_protocol "Proceed to server-authorized document/editor initialization"
                  }
                }
                opt "Authorized document/editor initialization completes" {
    hpx.browser.delivery_entry <- hpx.browser.c4_protocol "Install live adapter/documents; keys remain Rust-only"
                }
              }
            }
          }
        }
      }
    }
    style * { color primary }
    style element.tag = #planned { color muted; border dashed }
    include hpx.browser.c4_protocol with { navigateTo c4_frontend_delivery }
    include hpx.browser.delivery_entry with { navigateTo c4_frontend_delivery }
    include hpx.native.transport.lifecycle.c4_lifecycle with { navigateTo c4_api_routes }
    include hpx.native.transport.security.c4_bootstrap with { navigateTo c4_api_routes }
    include hpx.native.transport.security.c4_compare with { navigateTo c4_api_routes }
    include hpx.native.transport.security.c4_gates with { navigateTo c4_api_routes }
  }
}
