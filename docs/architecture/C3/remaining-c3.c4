  view c3_integrations of hpx.native.integrations {
    title "C3 / Integration adapters (planned)"
    description "Specification-backed proposal only: six existing planned roles, no native integration implementation or selected wire/packaging protocols. Dashed links are planned contracts; current browser-only exact Markdown download is separate. Disclosure/execution policy must be rechecked, and non-trusted plaintext egress remains denied by required core policy. External jobs are not atomic local transactions; no exactly-once remote-write guarantee. HPX-CAN-017: required HPX-DOM-001 allocation is recorded in view-only notes; current helper coverage is bounded. Precise concepts and unadopted mechanisms remain linked contracts; no conceptual gap is closed by allocation."
    link ../../05-domain/core-object-model.md
    link ../../05-domain/provenance-model.md
    link ../../06-subsystems/ai-collaboration.md
    link ../../06-subsystems/import-export.md
    link ../../06-subsystems/interfaces/browser-runtime.md
    link ../audits/c3-coverage-audit.md
    group "Integration adapters (planned)" { color muted; border dashed
      include hpx.native.integrations.agents with { description "Chat prompts/context/responses as workspace nodes; machine-user permissions. No HPX inference orchestration; transport/records unresolved."  notes "Required chat prompts/context/responses are workspace nodes and observable exchanges,distinct from resulting contributions. Preserve observed/declared/inferred provenance and adoption versus verification/authorship/endorsement. Workspace-local machine users use shared API permissions and ordinary graph/draft/Commit/history/recovery;inference stays machine-side. Existing planned role does not implement chat records,identity,MCP or provider accounts." }
      include hpx.native.integrations.citations with { description "Separate read-only desktop/cloud choices; freeze cited metadata; no fallback." }
      include hpx.native.integrations.word_import with { description "Bound untrusted parsing and review exact mappings before authorized application."  notes "Treat external statements/review evidence as untrusted input;capture exact source/revision/range and ordered mappings before authorised application operations. Imported content is not automatically authored or endorsed by the importer. General derivation/interaction formats remain unadopted;this planned adapter does not mutate graph state independently." }
      include hpx.native.integrations.export with { description "Freeze exact permitted inputs/citations/styles; packaging and Pandoc binding unresolved."  notes "Export authorised exact content/snapshot/occurrence context and provenance without live-head/provider substitution. Output is a projection/artifact,not a new logical identity,Commit or history deletion. Respect current disclosure policy;general packaging/citation/relationship representations remain linked contract/design work." }
      include hpx.native.integrations.github_jobs with { description "Separate publication, encrypted backup and release discovery; durable outcomes unresolved." }
      include hpx.native.integrations.federation with { description "Future authorized exchange/causality; no replication or conflict protocol selected." }
    }
    group "Existing scope and exact-state responsibilities" { color primary; border solid
      include hpx.native.authority with { description "Current sole-owner scope; workspace-user permissions/disclosure/egress policy remains partial." navigateTo c3_application }
      include hpx.native.application with { title "Application coordination" description "Co-located command/read responsibilities; current authority and original-result replay." navigateTo c3_application }
      include hpx.native.history with { description "Exact bounded retained-history/snapshot/anchor reads; current one-occurrence scope." }
      include hpx.native.storage with { title "Workspace persistence" description "Same native executable: supported workspace access, codecs, SQLite and retained state." navigateTo c3_workspace_persistence }
    }
    group "External context and current browser subset" { color primary; border solid
      include ai_users with { description "Workspace-local machine users provide chat and use MCP; inference stays on their side." }
      include zotero.desktop with { description "Planned desktop-local citation interface; separately configured." }
      include zotero.cloud with { description "Planned cloud citation interface; separately authenticated." }
      include exchange_files with { description "External input/output artifacts; no second running service or database." }
      include github with { description "Planned external release/publication/backup interactions; no connection enabled." }
      include peers with { description "Future authorized HPX peers; protocol and membership mechanisms remain unresolved." }
      include hpx.browser with { description "Current exact Markdown download runs in browser; native conversion remains planned." navigateTo c2_containers }
    }
    style * { color primary }
    style element.tag = #planned { color muted; border dashed }
    exclude * -> *
    include ai_users -> hpx.native.integrations.agents where kind is coverage_plan
    include hpx.native.integrations.citations -> zotero.desktop where kind is coverage_plan
    include hpx.native.integrations.citations -> zotero.cloud where kind is coverage_plan
    include exchange_files -> hpx.native.integrations.word_import where kind is coverage_plan
    include hpx.native.integrations.export -> exchange_files where kind is coverage_plan
    include hpx.native.integrations.github_jobs -> github where kind is coverage_plan
    include hpx.native.integrations.federation -> peers where kind is coverage_plan
    include hpx.native.integrations.agents -> hpx.native.authority where kind is planned_flow
    include hpx.native.integrations.citations -> hpx.native.authority where kind is planned_flow
    include hpx.native.integrations.word_import -> hpx.native.authority where kind is planned_flow
    include hpx.native.integrations.export -> hpx.native.authority where kind is planned_flow
    include hpx.native.integrations.github_jobs -> hpx.native.authority where kind is planned_flow
    include hpx.native.integrations.federation -> hpx.native.authority where kind is planned_flow
    include hpx.native.integrations.agents -> hpx.native.application where kind is planned_flow
    include hpx.native.integrations.word_import -> hpx.native.application where kind is planned_flow
    include hpx.native.integrations.export -> hpx.native.history where kind is planned_flow
    include hpx.native.integrations.citations -> hpx.native.storage where kind is planned_flow
    include hpx.native.integrations.github_jobs -> hpx.native.storage where kind is planned_flow
    include hpx.native.integrations.federation -> hpx.native.application where kind is planned_flow
    include hpx.browser -> exchange_files where kind is existing_flow
    exclude * -> * where kind is delivery_detail_call
    exclude * -> * where kind is delivery_detail_data
    exclude * -> * where kind is delivery_detail_build
    exclude * -> * where kind is coordination_call
    exclude * -> * where kind is coordination_control
    exclude * -> * where kind is coordination_data
    exclude * -> * where kind is coordination_result
    autoLayout LeftRight 100 90 spline
  }
}
