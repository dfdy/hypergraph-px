views {
  view c3_application of hpx.native.application {
    title "C3 / Application coordination"
    description "Logical responsibilities in current co-located Workspace methods, not a new application crate/services. Current authority before protected replay; draft ACK differs from Commit. Direct protected reads bypass command execution. Solid arrows are evidenced dependencies, with explicit return/data outputs, not a sequence or an adopted V3 refactor. HPX-CAN-011: required HPX-DOM-001 allocation is recorded in view-only notes; current helper coverage is bounded. Precise concepts and unadopted mechanisms remain linked contracts; no conceptual gap is closed by allocation."
    link ../../05-domain/core-object-model.md
    link ../../07-implementation/protocols/draft-publication.md
    link ../../06-subsystems/interfaces/browser-runtime.md
    link ../../06-subsystems/ai-collaboration.md
    link ../../05-domain/provenance-model.md
    link ../audits/c3-coverage-audit.md
    link ../audits/application-coordination-audit.md
    // Presentation boundary for the focal responsibility;shared code remains co-located as evidenced.
    group "Application coordination" { color primary; border solid
      group "Admission and replay" { color primary; border solid
        include hpx.native.application.admission with { description "Frozen command validation; writer transaction scope. Current authority precedes replay." navigateTo c4_application_transaction  notes "Required: authenticate workspace-local actor and enforce current workspace permissions before any protected operation. Validate exact document/branch/draft context and expected state; neither domain plans, selection nor unlock grant authority. Current sole-owner writer admission is incomplete multi-user evidence; no permission scheme adopted." }
        include hpx.native.application.replay with { description "Exact operation/digest and current result scope; original receipt before mutable rechecks." navigateTo c4_application_transaction  notes "Required: recheck current actor/result authority before returning a retained original receipt. Exact retry reconciles the original operation; changed reuse conflicts. Lost acknowledgement is not a new mutation or proof of Commit. Current bounded receipts do not implement general multi-user revocation or policy epochs." }
      }
      group "Feature dispatch" { color primary; border solid
        include hpx.native.application.dispatch with { description "Existing feature helpers; pure rules and staged effects share the same transaction." navigateTo c4_application_features  notes '''Required: coordinate pure plans for identity/occurrence, exact snapshots, relationships and derivations, keeping same-node parents distinct from cross-identity origins. Chat/observable interaction capture uses ordinary graph rules but is distinct from contribution/authorship. Existing feature helpers cover bounded one-owner cases; full closure, n-ary/event/interaction mechanisms remain contract-owned.

[Conceptual placement/derivation effects](../Conceptual/placement-effects.c4)''' }
      }
      group "Publication and protected reads" { color primary; border solid
        include hpx.native.application.publication with { description "One result + original receipt + COMMIT; draft acknowledgement remains distinct." navigateTo c4_application_transaction  notes '''Required: publish complete immutable result/closed snapshot/event and mutable head/draft/receipt changes atomically after current-state/authority checks. Draft acknowledgement and private checkpoints are not Commit; retain newer typing and immutable history. ADR019 is adopted design; current bounded transactions do not complete general publication or provenance mechanisms.

[Conceptual draft/Commit effects](../Conceptual/publication-effects.c4)''' }
        include hpx.native.application.reads with { description "Existing Workspace reads, called directly; no execute/read facade is introduced." navigateTo c4_application_reads  notes "Required: protected consistent reads and exact historical reconstruction with current authority, exact occurrence-path bindings and bounded scope. Never substitute current heads or infer historical-key rights from present access. Existing direct Workspace readers are partial evidence; no new facade, closure resolver or access mechanism is adopted." }
      }
    }
    // Callers,providers,artifacts and consumers stay outside the focal boundary.
    include hpx.native.assertions with { description "Role-labelled retrospective claims/review; no automatic logical proof." navigateTo c4_application_features }
    include hpx.native.authority with { description "Current sole-owner scope; workspace-user permissions/disclosure/egress policy remains partial." navigateTo c4_application_transaction notes '''[Conceptual authority and representation distinctions](../Conceptual/authority-distinction.c4)''' }
    include hpx.native.clipboard with { description "Private exact committed/working references; capture and promotion are not implicit Commit." navigateTo c4_application_features }
    include hpx.native.comments with { description "Pinned committed passage comments; broader annotation lifecycle remains partial." navigateTo c4_application_features }
    include hpx.native.documents with { description "Local documents/branches and owned drafts; general composition and parent-Merge remain incomplete." navigateTo c4_application_features }
    include hpx.native.domain with { title "Pure domain" description "Pure supplied-input rules/types; no serialization, authorization or storage IO." navigateTo c3_pure_domain }
    include hpx.native.provenance with { description "Pinned independent derivation and publisher evidence; not original-authorship proof." navigateTo c4_application_features }
    include hpx.native.storage with { title "Workspace persistence" description "Same native executable: supported workspace access, codecs, SQLite and retained state." navigateTo c3_workspace_persistence }
    include hpx.native.transport with { title "Runtime and API" description "Existing HTTPS/session/unlock/API boundary; startup remains locked." navigateTo c3_runtime_api }
    style * { color primary }
    style element.tag = #planned { color muted; border dashed }
    exclude * -> *
    include hpx.native.transport -> hpx.native.application.admission where kind is coverage_call with { title "Frozen command + operation" }
    include hpx.native.transport -> hpx.native.application.reads where kind is coverage_call with { title "Protected queries / receipt lookup" }
    include hpx.native.application.admission -> hpx.native.authority where kind is coverage_call
    include hpx.native.application.admission -> hpx.native.application.replay where kind is coverage_call
    include hpx.native.application.replay -> hpx.native.authority where kind is coverage_call
    include hpx.native.application.replay -> hpx.native.application.dispatch where kind is coverage_call
    include hpx.native.application.dispatch -> hpx.native.documents where kind is coverage_call
    include hpx.native.application.dispatch -> hpx.native.provenance where kind is coverage_call
    include hpx.native.application.dispatch -> hpx.native.clipboard where kind is coverage_call
    include hpx.native.application.dispatch -> hpx.native.assertions where kind is coverage_call
    include hpx.native.application.dispatch -> hpx.native.comments where kind is coverage_call
    include hpx.native.application.dispatch -> hpx.native.domain where kind is coverage_call
    include hpx.native.application.dispatch -> hpx.native.storage where kind is coverage_call
    include hpx.native.application.dispatch -> hpx.native.application.publication where kind is coverage_call
    include hpx.native.application.publication -> hpx.native.storage where kind is coverage_call
    include hpx.native.application.reads -> hpx.native.authority where kind is coverage_call
    include hpx.native.application.reads -> hpx.native.storage where kind is coverage_call
    exclude * -> * where kind is delivery_detail_call
    exclude * -> * where kind is delivery_detail_data
    exclude * -> * where kind is delivery_detail_build
    exclude * -> * where kind is coordination_call
    exclude * -> * where kind is coordination_control
    exclude * -> * where kind is coordination_data
    exclude * -> * where kind is coordination_result
    include hpx.native.application.admission -> hpx.native.transport where kind is coordination_result
    include hpx.native.application.replay -> hpx.native.transport where kind is coordination_result
    include hpx.native.application.publication -> hpx.native.transport where kind is coordination_result
    include hpx.native.application.reads -> hpx.native.transport where kind is coordination_result
    autoLayout LeftRight 100 90 spline
  }
  view c3_workspace_persistence of hpx.native.storage {
    title "C3 / Workspace persistence"
    description "Supported opening, adapter-owned representation and embedded SQLite state in the same Rust executable. Logical grouping is proposed, not new storage services. Encrypted bodies do not hide all structural metadata. WAL/transactions do not establish authenticated provenance, arbitrary closure, rollback detection or federation. Wider repair/temporal upgrade remain separate. HPX-CAN-012: required HPX-DOM-001 allocation is recorded in view-only notes; current helper coverage is bounded. Precise concepts and unadopted mechanisms remain linked contracts; no conceptual gap is closed by allocation."
    link ../../05-domain/core-object-model.md
    link ../../06-subsystems/workspace-storage.md
    link ../../06-subsystems/formats/hpx-workspace.md
    link ../../07-implementation/data-structures/sqlite-records.md
    link ../../08-assurance/recovery.md
    link ../audits/c3-coverage-audit.md
    group "Workspace persistence" { color primary; border solid
      include hpx.native.storage.access with { description "Explicit create/open, schemas1/2 and WAL/FULL; no implicit migration or enrollment."  notes "Workspace is the storage/key boundary, not a content identity or permission grant. Explicit supported open/create and passphrase/keychain unlock retain schema/record compatibility boundaries. Current schemas1/2 and trusted-server custody are bounded evidence; no new identity, epoch, format or client-held mechanism is adopted." }
      include hpx.native.storage.records with { description "Version/kind and expected-context checks; serialization stays outside pure domain." navigateTo c4_domain_sources  notes "Required: adapter-owned explicit version/kind wrappers and exact identity/context codecs for domain records; serialization stays outside pure domain. Logical identity is distinct from private commitments and ciphertext addresses. Current wrapped families do not define all Node/Occurrence/Manifest/Snapshot, n-ary edge or interaction records. Preserve exact source bytes and reject unsupported versions." }
      include hpx.native.storage.record_store with { description "Immutable records, mutable heads and generation checks in caller-owned SQLite transactions."  notes "Required: retain immutable revisions/manifests/snapshots/events/provenance separately from mutable heads/drafts; publish authorised complete results and original receipts atomically under exact preconditions. No automatic pruning or silent erasure. Current transactions are bounded evidence; one SQLite writer does not constrain product users or deliver full policy/closure." }
      include hpx.native.history with { description "Exact bounded retained-history/snapshot/anchor reads; current one-occurrence scope."  notes "Required: reconstruct exact closed historical snapshots and occurrence-path bindings without current-head/provider substitution; history reads remain permission-controlled. Existing one-occurrence history/anchor readers are partial implementation evidence, not general nested closure, retained-history grants or conceptual lifecycle completeness." }
      include hpx.native.recovery with { description "Immediate original-branch audit and bounded recovery; no repair or rollback witness."  notes "Required: recover acknowledged exact drafts, original receipts and immutable history across restart/crash without inferring Commit from timeout or discarding newer typing. WAL is recovery machinery, not provenance/history or federation convergence. Current bounded recovery does not provide arbitrary repair, hostile rollback detection or a redaction/erasure design." }
    }
    group "Existing executable and C2 context" { color primary; border solid
      include hpx.native.application with { title "Application coordination" description "Co-located command/read responsibilities; current authority and original-result replay." navigateTo c3_application }
      include hpx.native.domain with { title "Pure domain" description "Pure supplied-input rules/types; no serialization, authorization or storage IO." navigateTo c3_pure_domain }
      include hpx.native.crypto with { title "Cryptographic adapter" description "In-memory crypto adapter; TLS identity and current authorization remain separate." navigateTo c3_crypto }
      include hpx.native.keychain with { title "Keychain adapter" description "Explicit device-secret alternative; default passphrase recovery stays available." navigateTo c3_keychain }
      include hpx.workspace with { description "Embedded SQLite workspace/WAL; encrypted bodies plus visible structural metadata." navigateTo c2_containers }
      include enrollment_backups with { description "Existing verified encrypted schema1 snapshots created before keychain upgrade." }
    }
    style * { color primary }
    style element.tag = #planned { color muted; border dashed }
    exclude * -> *
    include hpx.native.application -> hpx.native.storage.record_store where kind is coverage_call
    include hpx.native.application -> hpx.native.history where kind is coverage_call
    include hpx.native.storage.record_store -> hpx.native.storage.records where kind is coverage_call
    include hpx.native.storage.records -> hpx.native.crypto where kind is coverage_call
    include hpx.native.history -> hpx.native.storage.record_store where kind is coverage_call
    include hpx.native.storage.access -> hpx.native.storage.record_store where kind is coverage_call
    include hpx.native.storage.access -> hpx.native.crypto where kind is coverage_call
    include hpx.native.keychain -> hpx.native.storage.access where kind is coverage_call
    include hpx.native.keychain -> hpx.native.storage.record_store where kind is coverage_call
    include hpx.native.recovery -> hpx.native.storage.record_store where kind is coverage_call
    include hpx.native.storage.records -> hpx.native.domain where kind is coverage_data
    include hpx.native.storage.record_store -> hpx.workspace where kind is coverage_data
    include hpx.native.keychain -> enrollment_backups where kind is coverage_data
    exclude * -> * where kind is delivery_detail_call
    exclude * -> * where kind is delivery_detail_data
    exclude * -> * where kind is delivery_detail_build
    exclude * -> * where kind is coordination_call
    exclude * -> * where kind is coordination_control
    exclude * -> * where kind is coordination_data
    exclude * -> * where kind is coordination_result
    autoLayout LeftRight 100 90 spline
  }
  view c3_crypto of hpx.native.crypto {
    title "C3 / Cryptographic adapter"
    description "In-memory responsibility decomposition of the existing crypto crate. Solid arrows are calls/dependencies; dotted arrows are managed-secret data dependencies. Current authority and expected context come from callers. Key/nonce entropy is OS-backed; no filesystem/network policy or TLS key lifecycle is implemented here. Address utility is not wired into production SQLite addressing. HPX-CAN-015: required HPX-DOM-001 allocation is recorded in view-only notes; current helper coverage is bounded. Precise concepts and unadopted mechanisms remain linked contracts; no conceptual gap is closed by allocation."
    link ../../05-domain/core-object-model.md
    link ../../06-subsystems/security-cryptography.md
    link ../../06-subsystems/interfaces/crypto-adapter.md
    link ../../06-subsystems/formats/crypto-envelopes.md
    link ../audits/c3-coverage-audit.md
    group "Cryptographic adapter" { color primary; border solid
      include hpx.native.crypto.material with { description "OS entropy and managed secret lifetime; no complete host-memory erasure guarantee." }
      include hpx.native.crypto.envelopes with { description "Authenticate caller-expected record context before plaintext; no permissions or IO."  notes "Authenticate independently supplied workspace/kind/identity/generation/epoch context before returning plaintext. The authorised application supplies expected context;untrusted envelope fields and successful authentication do not grant resource rights. Existing primitives do not define a general SecurityPolicy,principal or provenance-signature mechanism." }
      include hpx.native.crypto.wrapping with { description "Same data key, expected workspace/epoch; passphrase or device secret, not new custody."  notes "Wrap/unwrap the same workspace key using adopted passphrase/device-secret boundaries. Key availability is distinct from user authentication,permission and policy authority. Logical identities survive re-encryption;no client-held custody,epoch migration or group key hierarchy is selected here." }
      include hpx.native.crypto.derivation with { description "Fixed Argon2id profile, bounded allocation and zeroizing working memory." }
      include hpx.native.crypto.addressing with { description "Ciphertext hash utility; tests use it, no production SQLite consumer found."  notes "StorageAddress hashes ciphertext,not logical content/revision identity or a private plaintext commitment. Equality grants no permission to disclose cross-domain existence. This utility has no production SQLite consumer;general private commitments,signing/deduplication and catalogue/address mechanisms remain unadopted." }
    }
    group "Actual caller responsibilities" { color primary; border solid
      include hpx.native.storage with { title "Workspace persistence" description "Same native executable: supported workspace access, codecs, SQLite and retained state." navigateTo c3_workspace_persistence }
      include hpx.native.keychain with { title "Keychain adapter" description "Explicit device-secret alternative; default passphrase recovery stays available." navigateTo c3_keychain }
    }
    style * { color primary }
    style element.tag = #planned { color muted; border dashed }
    exclude * -> *
    include hpx.native.storage -> hpx.native.crypto.material where kind is coverage_call
    include hpx.native.storage -> hpx.native.crypto.envelopes where kind is coverage_call
    include hpx.native.storage -> hpx.native.crypto.wrapping where kind is coverage_call
    include hpx.native.keychain -> hpx.native.crypto.wrapping where kind is coverage_call
    include hpx.native.crypto.wrapping -> hpx.native.crypto.derivation where kind is coverage_call
    include hpx.native.crypto.envelopes -> hpx.native.crypto.material where kind is coverage_data
    include hpx.native.crypto.wrapping -> hpx.native.crypto.material where kind is coverage_data
    exclude * -> * where kind is delivery_detail_call
    exclude * -> * where kind is delivery_detail_data
    exclude * -> * where kind is delivery_detail_build
    exclude * -> * where kind is coordination_call
    exclude * -> * where kind is coordination_control
    exclude * -> * where kind is coordination_data
    exclude * -> * where kind is coordination_result
    autoLayout LeftRight 100 90 spline
  }
  view c3_keychain of hpx.native.keychain {
    title "C3 / Keychain adapter"
    description "Explicit ADR014 lifecycle, native provider, verified upgrade backup and cleanup ordering. Logical parts share existing files, not new processes. macOS support is bounded; passphrase recovery retained. Enrollment/removal are not startup actions or revocation/erasure guarantees. Arrows describe dependencies, not a full sequence. No credential/state operation runs for this model. HPX-CAN-016: required HPX-DOM-001 allocation is recorded in view-only notes; current helper coverage is bounded. Precise concepts and unadopted mechanisms remain linked contracts; no conceptual gap is closed by allocation."
    link ../../05-domain/core-object-model.md
    link ../../04-architecture/decisions/0014-keychain-unlock-policy.md
    link ../../06-subsystems/security-cryptography.md
    link ../audits/c3-coverage-audit.md
    group "Keychain adapter" { color primary; border solid
      include hpx.native.keychain.lifecycle with { description "Unlocked explicit enroll/remove; locked status reads no native credential. Recovery retained."  notes "ADR014 adopts explicit enrollment with verified pre-upgrade backup and retained passphrase recovery. This is key availability support,not a principal/device/group directory,user permission grant or security-policy epoch design. Historical initial-slice no-keychain wording is not current exclusion;existing macOS lifecycle evidence remains bounded." }
      include hpx.native.keychain.unlock with { description "Explicit device-secret unlock and same-key verification; not a browser session grant." navigateTo seq_unlock  notes "Unlock the same workspace key only through explicit enrolled-device flow;workspace unlock,session authentication and resource authority remain separate. Removing enrollment is neither revocation of previously disclosed content nor history erasure. No client-held custody,permission or recovery-key mechanism is adopted." }
      include hpx.native.keychain.provider with { description "macOS create-only scoped native item; unsupported platforms report unavailable." }
      include hpx.native.keychain.backup with { description "Verified schema1 SQLite recovery copy before explicit upgrade; not portable backup." }
      include hpx.native.keychain.cleanup with { description "Unlocked-process retry handle only; crash orphan requires scoped manual recovery." }
    }
    group "Existing executable and C2 context" { color primary; border solid
      include hpx.native.transport with { title "Runtime and API" description "Existing HTTPS/session/unlock/API boundary; startup remains locked." navigateTo c3_runtime_api }
      include hpx.native.storage with { title "Workspace persistence" description "Same native executable: supported workspace access, codecs, SQLite and retained state." navigateTo c3_workspace_persistence }
      include hpx.native.crypto with { title "Cryptographic adapter" description "In-memory crypto adapter; TLS identity and current authorization remain separate." navigateTo c3_crypto }
      include credentials with { description "macOS native credential store; no cloud/plaintext/environment fallback." }
      include enrollment_backups with { description "Existing verified encrypted schema1 snapshots created before keychain upgrade." }
    }
    style * { color primary }
    style element.tag = #planned { color muted; border dashed }
    exclude * -> *
    include hpx.native.transport -> hpx.native.keychain.lifecycle where kind is coverage_call
    include hpx.native.transport -> hpx.native.keychain.unlock where kind is coverage_call
    include hpx.native.keychain.lifecycle -> hpx.native.keychain.backup where kind is coverage_call
    include hpx.native.keychain.lifecycle -> hpx.native.keychain.provider where kind is coverage_call
    include hpx.native.keychain.lifecycle -> hpx.native.keychain.unlock where kind is coverage_call
    include hpx.native.keychain.lifecycle -> hpx.native.keychain.cleanup where kind is coverage_call
    include hpx.native.keychain.cleanup -> hpx.native.keychain.provider where kind is coverage_call
    include hpx.native.keychain.unlock -> hpx.native.keychain.provider where kind is coverage_call
    include hpx.native.keychain.unlock -> hpx.native.crypto where kind is coverage_call
    include hpx.native.keychain.lifecycle -> hpx.native.crypto where kind is coverage_call
    include hpx.native.keychain.backup -> hpx.native.storage where kind is coverage_call
    include hpx.native.keychain.backup -> enrollment_backups where kind is coverage_data
    include hpx.native.keychain.provider -> credentials where kind is coverage_data
    exclude * -> * where kind is delivery_detail_call
    exclude * -> * where kind is delivery_detail_data
