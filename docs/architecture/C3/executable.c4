  hpx.native.integrations.word_import -[planned_flow]-> hpx.native.application "Authorized import plan" { metadata { evidence "docs/06-subsystems/external-integrations.md" scope "logical responsibility; no code refactor" }
    link ../../06-subsystems/external-integrations.md
