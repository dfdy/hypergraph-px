views {
  view c3_executable of hpx.native {
    title "C3 / HPX Rust executable"
    description "Five logical responsibility areas inside one executable; proposed for V3 review, not five new modules or services. Captions summarize the detailed source-linked responsibility catalogue; principal internal dependencies and every specified Rust-to-C2 boundary relationship are shown. Direct internal read/unlock paths and feature flows remain in the model. Frontend delivery, explicit unlock and cryptographic adapters are expanded to expose specified internal boundaries. The application-area read arrow summarizes co-located protected read services, not Workspace::execute. Blocks match C2: blue for ordinary components, grey/dashed for planned components. Blue does not distinguish implemented from partial. Status badges only: green implemented within stated scope; amber partial; grey planned. Group borders express visual hierarchy, not implementation status. HPX-CAN-009 allocates HPX-DOM-001 responsibilities in overview-only notes; precise linked contracts remain authoritative. Required product obligations and proposed mechanisms are distinct from current one-owner evidence; component mentions do not complete conceptual identities, cardinalities, lifecycle or operation effects. Stop after this overview for owner review."
    // Presentation groups only: no new module, process or storage boundary.
    group "HPX Rust executable" {
      color primary
      border solid
      include hpx.native.transport with {
        title "Runtime and API"
        navigateTo c3_runtime_api
        description "Browser HTTPS / AI MCP share user API. Per-user rights required; current multi-user/MCP gaps. TLS and workspace keys differ."
        notes "HPX-DOM-001 / HPX-CAN-009: owns human/machine admission through the shared logical command/query API via browser HTTPS and required MCP adapters; enforces authentication/session/transport gates and routes all protected operations through application policy. Authentication, workspace unlock and workspace-user resource permission remain distinct; no adapter bypass. Human and machine users are workspace-local; at most one machine user per provider per workspace; models/sessions/chats are not extra users and no separate node/edge ACL is required. Identity/permission/session/MCP mechanisms remain unadopted. Current sole-owner HTTPS is partial evidence. Machine-user inference remains outside HPX."
        color primary
      }
      include hpx.native.frontend_assets with {
        title "Frontend delivery"
        navigateTo c3_frontend_delivery
        description "Embedded browser assets; opens the focused Frontend delivery responsibility diagram."
        notes "HPX-DOM-001 / HPX-CAN-009 supporting scope only: prepares/delivers embedded browser assets; browser-derived presentation remains C2 responsibility. Asset delivery does not own domain identities, grant workspace permissions or move inference into HPX. Existing delivery evidence does not complete the object model."
        color primary
      }
      include hpx.native.keychain with {
        title "Keychain adapter"
          navigateTo c3_keychain
        description "Explicit device-secret alternative; passphrase recovery retained. macOS only; broader support planned."
        notes "HPX-DOM-001 / HPX-CAN-009 supporting scope only: explicit ADR014 enrollment and device-secret unlock of the same workspace key, verified pre-upgrade backup and retained passphrase recovery. Key availability is not authentication or resource permission; this adapter is not a principal/device/group directory or policy authority. Existing macOS evidence does not establish multi-user, client-held custody or other-platform delivery."
        color primary
      }
      include hpx.native.crypto with {
        title "Cryptographic adapter"
          navigateTo c3_crypto
        description "Authenticated envelopes and key wrapping. No authorization, file or network I/O."
        notes "HPX-DOM-001 / HPX-CAN-009 supporting scope only: authenticated record envelopes, key wrapping and supplied workspace/kind/identity/generation/epoch context. Does not authorize operations, choose logical identities or define user/permission policy. Logical IDs, private digests and ciphertext addresses remain distinct; general commitment/signature/deduplication and security-policy epoch mechanisms remain contract/design gaps. No new primitive, custody mode or format is adopted."
        color primary
      }
      include hpx.native.integrations with {
        title "Integration adapters (planned)"
          navigateTo c3_integrations
        description "Agents, citations, import/export, GitHub jobs and peer exchange. Designs remain unresolved."
        notes "HPX-DOM-001 / HPX-CAN-009 supporting scope only: authorised/rechecked external import/export, citations, publication/backup and future peer exchange through ordinary application semantics and confidentiality gates. Machine users use chat/MCP through shared API; inference stays on the machine-user side. No HPX inference endpoint/orchestrator or extra provider account/user is implied by the existing agent caption. Interaction records/external inputs do not themselves establish authorship, verification or permission. Future mechanisms remain planned/unadopted, separate from mandatory same-workspace multi-user scope."
        color muted
        border dashed
      }
      group "Hypergraph responsibilities" {
        color primary
        border solid
        include hpx.native.application with {
          title "Application coordination"
          navigateTo c3_application
          description "Shared user API: scoped reads/commands and per-user rights. Current owner slice only; draft ACK is not Commit; atomic result + receipt."
        notes "HPX-DOM-001 / HPX-CAN-009: owns authorization and editing/operation coordination over domain plans; protected consistent reads, exact base/head/policy rechecks, draft acknowledgement versus Commit, and atomic publication of complete results/history/heads/receipts through persistence. Keeps newer typing, uncertain outcomes and recovery semantics distinct. Coordinates attributable events, transformations and observable interaction/chat-node capture without conflating contributions, observed/declared/inferred provenance, adoption, verification or endorsement. Human and machine operations share semantics and current workspace-user permission enforcement; pure plans, selected nodes and key possession grant no authority. Current co-located one-owner writer/read services are incomplete implementation evidence; general multi-user, interaction and complete closure remain obligations, not implemented mechanisms."
          color primary
        }
        include hpx.native.domain with {
          title "Pure domain"
          navigateTo c3_pure_domain
          description "Deterministic identities, exact-source rules and bounded plans. No I/O, authorization or serialization. Partial."
        notes "HPX-DOM-001 / HPX-CAN-009: owns pure typed identities, invariants and deterministic plans for Node/Revision, Document/Branch, Occurrence/Manifest and exact closed Snapshot bindings. Owns pure validation of same-node ancestry versus cross-identity derivation, byte/anchor rules, revisioned n-ary hyperedges with ordered role-labelled participants, predicates/assertions, semantic events and provenance distinctions; application supplies complete exact context. Plans grant no authority. No serialization, entropy, storage, crypto or I/O. Full relationships/cardinalities/lifecycle and occurrence-path closure remain in HPX-DOM-001 and domain-navigation, not established by this component. Current bounded pure types/planners are partial evidence, not delivery of the complete required model."
          color primary
        }
        include hpx.native.storage with {
          title "Workspace persistence"
          navigateTo c3_workspace_persistence
          description "Adapter-owned codecs; encrypted transactions, exact reads, drafts/receipts and recovery. Broader repair remains planned."
        notes "HPX-DOM-001 / HPX-CAN-009: owns adapter DTOs/codecs with explicit persistent record versions/kinds, encrypted immutable records/history and mutable drafts/heads/receipts, consistent exact reads, transaction publication and crash recovery. Persists authorised application results and exact reconstruction bindings; never repairs history using current heads. Logical IDs are distinct from private plaintext commitments and ciphertext lookup addresses. WAL recovery is not application history, authenticated provenance or federation convergence. Precise formats/epochs and retained-history rules stay in workspace/record/recovery contracts; no version, schema or address scheme is selected. Existing bounded encrypted SQLite records and recovery are evidence, not a complete general object model."
          color primary
        }
      }
    }
    // C2 neighbours retain their existing identities and source-backed relationships.
    include user with { description "Launches and configures the executable." }
    include hpx.browser with { description "Browser editor; authenticated local HTTPS; embedded assets." navigateTo c2_containers }
    include hpx.workspace with { description "Authoritative encrypted SQLite workspace; WAL/SHM while open." navigateTo c2_containers }
    include credentials with { description "Optional explicit native keychain operations; passphrase recovery retained." }
    include enrollment_backups with { description "Verified encrypted backup before explicit keychain enrollment." }
    include exchange_files with { description "Future native import/export and portable backups; formats remain gated." }
    include ai_users with { description "AI users: required selected-node MCP access; human-equivalent permissions and editing semantics." }
    group "Future external integrations" {
      color muted
      border dashed
      include zotero.desktop with { description "Planned read-only desktop-local citations." }
      include zotero.cloud with { description "Planned read-only cloud citations." }
      include github with { description "Planned release discovery, approved publication and encrypted backup." }
      include peers with { description "Future authorized exchange and federation." }
    }
    // Block fills express structure; fixed-colour badges express status.
    style * { color primary }
    style element.tag = #planned { color muted; border dashed }
    // Keep principal evidenced dependencies; omit feature-level wiring from C3.
    exclude * -> *
    include hpx.native.transport -> hpx.native.application where tag is not #planned with { title "Commands / protected reads" }
    include hpx.native.application -> hpx.native.domain with { title "Validate plans" }
    include hpx.native.application -> hpx.native.storage with { title "Consistent reads / atomic result + receipt" }
    include hpx.native.application -> hpx.native.integrations with { title "Authorize / recheck execution (planned)" }
    include hpx.native.integrations -> hpx.native.application with { title "Reviewed inputs / proposals (planned)" }
    include hpx.native.transport -> hpx.native.frontend_assets with { title "Serve embedded bytes" }
    include hpx.native.transport -> hpx.native.keychain with { title "Explicit keychain actions" }
    include hpx.native.transport -> hpx.native.storage with { title "Passphrase create / unlock" }
    include hpx.native.keychain -> hpx.native.storage with { title "Enrollment state / verified backup" }
    include hpx.native.storage -> hpx.native.crypto with { title "Seal / authenticate records" }
    include hpx.native.keychain -> hpx.native.crypto with { title "Wrap / unlock same workspace key" }
    // Only these cross-boundary relationships are added. No new model flows.
    include user -> hpx.native.transport with { title "Launch / configure" }
    include hpx.browser -> hpx.native.transport with { title "Shared API / HTTPS" }
    include hpx.native.frontend_assets -> hpx.browser with { title "Embedded frontend assets" }
    include hpx.native.storage -> hpx.workspace with { title "Encrypted reads / writes" }
    include hpx.native.keychain -> credentials with { title "Optional keychain unlock" }
    include hpx.native.storage -> enrollment_backups with { title "Before keychain upgrade" }
    include ai_users -> hpx.native.transport with { title "MCP (required; planned)" }
    include hpx.native.integrations -> zotero.desktop with { title "Desktop citations (planned)" }
    include hpx.native.integrations -> zotero.cloud with { title "Cloud citations (planned)" }
    include hpx.native.integrations -> github with { title "Releases / publication / backup (planned)" }
    include hpx.native.integrations -> peers with { title "Federation / exchange (future)" }
    include exchange_files -> hpx.native.integrations with { title "Document / package import (planned)" }
    include hpx.native.integrations -> exchange_files with { title "Export / portable backup (planned)" }
    rank source { user, ai_users, hpx.browser }
    exclude * -> * where kind is code_call
    exclude * -> * where kind is delivery_build
    exclude * -> * where kind is delivery_call
    exclude * -> * where kind is delivery_code
    exclude * -> * where kind is domain_use
    exclude * -> * where kind is domain_call
    exclude * -> * where kind is domain_type
    exclude * -> * where kind is domain_test
    exclude * -> * where kind is coverage_call
    exclude * -> * where kind is coverage_data
    exclude * -> * where kind is coverage_plan
    exclude * -> * where kind is delivery_detail_call
    exclude * -> * where kind is delivery_detail_data
    exclude * -> * where kind is delivery_detail_build
    exclude * -> * where kind is coordination_call
    exclude * -> * where kind is coordination_control
    exclude * -> * where kind is coordination_data
    exclude * -> * where kind is coordination_result
    include hpx.native.application -> hpx.native.transport where metadata.scope is "application_io_engine"
    exclude * -> * where kind is browser_detail
    exclude * -> * where kind is browser_organisation
    exclude * -> * where kind is browser_presentation
    autoLayout TopBottom 100 90 spline
  }
}
