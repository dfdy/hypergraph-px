  hpx.native.integrations.export -[planned_flow]-> hpx.native.history "Freeze exact export inputs" { metadata { evidence "docs/06-subsystems/import-export.md" scope "logical responsibility; no code refactor" }
    link ../../06-subsystems/import-export.md
  }
  hpx.native.integrations.citations -[planned_flow]-> hpx.native.storage "Capture cited metadata" { metadata { evidence "docs/06-subsystems/import-export.md" scope "logical responsibility; no code refactor" }
    link ../../06-subsystems/import-export.md
