// Canonical definition location: HPX-CAN-003 (HPX-OWNER-032). Existing design/implementation statuses retain their authority; see docs/architecture/SPECIFICATION.md.
// Specification-derived C3 responsibility model. Proposed for owner review.
// Co-located functions are not new crates or independently deployed services.
specification {
  element executable
  element component
  // Status badges have fixed semantic colours, independent of block fills.
  tag planned { color muted }
  tag implemented { color green }
  tag partial { color amber }
  relationship native_call { line solid; color slate }
}

model {
  extend hpx {
    native = executable "HPX Rust executable" {
    technology "Rust; embedded frontend; bundled SQLite"
    description "Specification-based responsibility boundaries for review. Components are not separate processes or necessarily separate crates. Startup consumes an explicit workspace path and separately provisioned TLS certificate/private-key files; transport keys are distinct from workspace encryption keys and the optional keychain device secret. No trust installation, external witness or provider connection occurs by implication. Node, Lean, a database server and user-installed Pandoc are not release prerequisites. Future Pandoc binding/helper packaging and independently trusted client delivery remain unselected design gates."
    link ../../04-architecture/system-architecture.md
    link ../../04-architecture/decisions/0004-local-https-bootstrap.md
    link ../../04-architecture/component-architecture.md
      domain = component "Pure domain" {
        #partial
        summary "Deterministic identities, exact ranges and bounded plans."
        description "Dependency-free typed identities and byte/UTF16 validation; bounded supplied expansion, assertion/comment, independent Fork/Synthesis and supplied-map parent-Merge planning. No serialization, entropy, authorization or I/O. Full nested-closure and multi-owner plans remain incomplete."
        metadata { authority "proposed architectural grouping" implementation "partial" paths ["backend/crates/domain/src/lib.rs", "backend/crates/domain/src/records.rs", "backend/crates/domain/src/expansion.rs", "backend/crates/domain/src/fork.rs", "backend/crates/domain/src/merge.rs", "backend/crates/domain/src/parent_merge.rs", "backend/crates/domain/src/working.rs"] }
        link ../../05-domain/core-object-model.md
        link ../../05-domain/hypergraph-mathematics.md
        link ../../06-subsystems/interfaces/domain-navigation.md
        link ../../07-implementation/algorithms/parent-merge.md
        link ../../../backend/crates/domain/src/lib.rs
        link ../../../backend/crates/domain/src/records.rs
        link ../../../backend/crates/domain/src/expansion.rs
        link ../../../backend/crates/domain/src/fork.rs
        link ../../../backend/crates/domain/src/merge.rs
        link ../../../backend/crates/domain/src/parent_merge.rs
        link ../../../backend/crates/domain/src/working.rs
      }
      application = component "Command and publication coordinator" {
        #implemented
        summary "Authorize, plan, recheck and publish one atomic result."
        description "Logical application coordinator currently hosted in Workspace::execute/execute_inner in backend/crates/storage. Validates frozen commands, checks current sole-owner authority before protected receipt replay, rechecks expected state, and atomically publishes bounded local results and receipts. Changed operation reuse conflicts; unknown outcomes reconcile the original request. Not a separate crate, process or general distributed transaction service."
        metadata { authority "proposed architectural grouping" implementation "implemented" paths ["backend/crates/storage/src/lib.rs", "backend/crates/storage/src/authority.rs"] }
        link ../../04-architecture/component-architecture.md
        link ../../07-implementation/protocols/draft-publication.md
        link ../../../backend/crates/storage/src/lib.rs
        link ../../../backend/crates/storage/src/authority.rs
      }
      authority = component "Authority and confidentiality policy" {
        #partial
        summary "Current owner scope; broader rights and egress gates remain planned."
        description "Current one-owner catalog/device and source/result checks are independent of IDs,session authentication and receipts. Mandatory multi-user/AI principal membership,grants and isolation remain implementation gaps (HPX-OWNER-027). Workspace-user permissions at the shared user API are mandatory (HPX-OWNER-029), not UI-only checks. Workspace permission administration/revocation and client-held core egress checks remain unimplemented; no mandatory node ACL is selected. Every future provider/file/clipboard/print/job sink must enforce the adopted mode policy below its UI. No new policy engine, identity provider or permission scheme is selected."
        metadata { authority "proposed architectural grouping" implementation "partial" paths ["backend/crates/storage/src/authority.rs", "backend/crates/storage/src/lib.rs"] }
        link ../../06-subsystems/security-cryptography.md
        link ../../03-requirements/system-requirements.md
        link ../../02-governance/OWNER_DECISIONS.md
        link ../../../backend/crates/storage/src/authority.rs
        link ../../../backend/crates/storage/src/lib.rs
      }
      documents = component "Documents, branches and working edits" {
        #partial
        summary "Create, Save, Commit, branch, Fork and reviewed Synthesis."
        description "Owns bounded local document/branch drafts, exact generation/base/sequence checks, departure Commit, immutable checkpoints and distinct cross-identity derivation versus same-node history. Existing independent Synthesis is not parent-branch Merge. Pure supplied-map parent-Merge and disposable schema3 single-parent temporal foundations do not deliver production two-parent publication, upgrade or normal opening."
        metadata { authority "proposed architectural grouping" implementation "partial" paths ["backend/crates/storage/src/lib.rs", "backend/crates/storage/src/branches.rs", "backend/crates/storage/src/branches/merge_base.rs", "backend/crates/storage/src/working.rs", "backend/crates/storage/src/forks.rs", "backend/crates/storage/src/merges.rs", "backend/crates/storage/src/working_forks.rs", "backend/crates/storage/src/temporal_commit.rs", "backend/crates/storage/src/temporal_save.rs"] }
        link ../../06-subsystems/document-engine.md
        link ../../05-domain/document-semantics.md
        link ../../04-architecture/decisions/0015-initial-merge-workflow.md
        link ../../04-architecture/decisions/0018-initial-local-branches.md
        link ../../04-architecture/decisions/0019-working-branches-and-reference-checkpoints.md
        link ../../07-implementation/algorithms/parent-merge.md
        link ../../../backend/crates/storage/src/lib.rs
        link ../../../backend/crates/storage/src/branches.rs
        link ../../../backend/crates/storage/src/branches/merge_base.rs
        link ../../../backend/crates/storage/src/working.rs
        link ../../../backend/crates/storage/src/forks.rs
        link ../../../backend/crates/storage/src/merges.rs
        link ../../../backend/crates/storage/src/working_forks.rs
        link ../../../backend/crates/storage/src/temporal_commit.rs
        link ../../../backend/crates/storage/src/temporal_save.rs
      }
      composition = component "Composition and source ownership" {
        #partial
        summary "Single-occurrence foundation; general composition remains gated."
        description "Manifests and exact owned context exist for the current one-owner whole-document slice. General chapter collections, ordered repeated/nested occurrences, promotion/split, multi-owner edit plans, Move/Fork/Embed, pinned/live transclusion and complete cycle/permission revalidation remain target responsibilities, not enabled services. No new entity schema, CRDT, closure cache or resolver algorithm is selected."
        metadata { authority "proposed architectural grouping" implementation "partial" paths ["backend/crates/storage/src/lib.rs", "backend/crates/domain/src/records.rs", "backend/crates/domain/src/expansion.rs"] }
        link ../../05-domain/document-semantics.md
        link ../../05-domain/text-and-anchors.md
        link ../../06-subsystems/document-engine.md
        link ../../06-subsystems/interfaces/domain-navigation.md
        link ../../../backend/crates/storage/src/lib.rs
        link ../../../backend/crates/domain/src/records.rs
        link ../../../backend/crates/domain/src/expansion.rs
      }
      queries = component "Graph navigation and read projections" {
        #partial
        summary "Bounded, authorized graph views; general queries remain planned."
        description "Current induced document/Fork, assertion incidence and transformation projections retain roles, direction, exact selected context, outside-selection counts and work limits. General nodes/references/backlinks/occurrences, impact/search/index families and concept/assertion-to-assertion navigation remain unimplemented or unspecified. No separate graph database or authoritative semantic store is introduced."
        metadata { authority "proposed architectural grouping" implementation "partial" paths ["backend/crates/storage/src/graph.rs", "backend/crates/storage/src/overlay_graph.rs"] }
        link ../../06-subsystems/graph-engine.md
        link ../../06-subsystems/interfaces/domain-navigation.md
        link ../../../backend/crates/storage/src/graph.rs
        link ../../../backend/crates/storage/src/overlay_graph.rs
      }
      history = component "Snapshots, history and exact anchors" {
        #partial
        summary "Read retained exact states without following newer heads."
        description "One-occurrence snapshot reconstruction, immutable history/branch paging, exact historical byte-range reads and bounded common-base inspection exist. Complete nested closure/source maps, general reconstruction compiler resources and all-history navigation remain separate requirements. Reference cycles differ from recursive expansion cycles; inspection cannot mutate snapshots or publish history."
        metadata { authority "proposed architectural grouping" implementation "partial" paths ["backend/crates/storage/src/lib.rs", "backend/crates/storage/src/history.rs", "backend/crates/storage/src/anchors.rs", "backend/crates/storage/src/branches/merge_base.rs"] }
        link ../../05-domain/document-semantics.md
        link ../../05-domain/text-and-anchors.md
        link ../../06-subsystems/interfaces/domain-navigation.md
        link ../../../backend/crates/storage/src/lib.rs
        link ../../../backend/crates/storage/src/history.rs
        link ../../../backend/crates/storage/src/anchors.rs
        link ../../../backend/crates/storage/src/branches/merge_base.rs
      }
      provenance = component "Derivation and contributor evidence" {
        #partial
        summary "Pinned derivation and publisher facts, not inferred authorship."
        description "Current immutable Fork/Synthesis/working-source derivations and bounded snapshot-bound publication contributors preserve exact source identities and original-authorship uncertainty. Full observed/declared/inferred authorship, influence, interaction capture, adoption, rights attribution and verification remain distinct future requirements. No authenticated-peer or complete contributor-index claim."
        metadata { authority "proposed architectural grouping" implementation "partial" paths ["backend/crates/storage/src/forks.rs", "backend/crates/storage/src/merges.rs", "backend/crates/storage/src/working_forks.rs", "backend/crates/storage/src/contributors.rs"] }
        link ../../05-domain/provenance-model.md
        link ../../06-subsystems/interfaces/browser-runtime.md
        link ../../03-requirements/user-needs.md
        link ../../../backend/crates/storage/src/forks.rs
        link ../../../backend/crates/storage/src/merges.rs
        link ../../../backend/crates/storage/src/working_forks.rs
        link ../../../backend/crates/storage/src/contributors.rs
      }
      assertions = component "Semantic assertions and predicate catalogue" {
        #partial
        summary "Versioned, role-labelled claims and retrospective review."
        description "Current predicates, exact participant captures, n-ary roles, negation/certainty/attribution/scope and revisioned review overlays are separate from text snapshots and browsing categories. Manual contextual equivalence is not automatic discovery, a checked proof or identity equality. General semantic entities and structured evidence remain future scope; owner-deferred statement-to-Lean conversion is not enabled."
        metadata { authority "proposed architectural grouping" implementation "partial" paths ["backend/crates/domain/src/assertion.rs", "backend/crates/storage/src/assertions.rs", "backend/crates/storage/src/predicates.rs", "shared/predicate-catalog-v1.json"] }
        link ../../05-domain/assertions-and-predicates.md
        link ../../06-subsystems/graph-engine.md
        link ../../04-architecture/decisions/0010-semantic-annotation-snapshots.md
        link ../../02-governance/requests.md
        link ../../../backend/crates/domain/src/assertion.rs
        link ../../../backend/crates/storage/src/assertions.rs
        link ../../../backend/crates/storage/src/predicates.rs
        link ../../../shared/predicate-catalog-v1.json
      }
      comments = component "Anchored document comments" {
        #partial
        summary "Immutable retrospective comments on committed passages."
        description "Current exact committed-source comments and bounded append-only paging preserve historical anchors. Draft anchors, replies, editing, resolution, shared-user lifecycle and imported Word threads remain future scope. Comments are user annotations, not agent conversation or changes to earlier text snapshots."
        metadata { authority "proposed architectural grouping" implementation "partial" paths ["backend/crates/domain/src/comment.rs", "backend/crates/storage/src/comments.rs"] }
        link ../../04-architecture/decisions/0017-initial-durable-comments.md
        link ../../06-subsystems/interfaces/browser-runtime.md
        link ../../../backend/crates/domain/src/comment.rs
        link ../../../backend/crates/storage/src/comments.rs
      }
      clipboard = component "Private provenance clipboard" {
        #partial
        summary "Encrypted references, working checkpoints and retained promotions."
        description "Current principal/workspace-isolated committed and working references, immutable exact checkpoints, independent working-source Fork, promotion and separately acknowledged replacements retain originals. Capture is not Commit or derivation. Full atomic Paste All, multi-component selections and general entity replacement remain gated. Ordinary OS copy/paste executes in the browser and is a separate egress sink."
        metadata { authority "proposed architectural grouping" implementation "partial" paths ["backend/crates/storage/src/clipboard.rs", "backend/crates/storage/src/working.rs", "backend/crates/storage/src/working_clipboard.rs", "backend/crates/storage/src/working_forks.rs"] }
        link ../../06-subsystems/document-engine.md
        link ../../04-architecture/decisions/0019-working-branches-and-reference-checkpoints.md
        link ../../../backend/crates/storage/src/clipboard.rs
        link ../../../backend/crates/storage/src/working.rs
        link ../../../backend/crates/storage/src/working_clipboard.rs
        link ../../../backend/crates/storage/src/working_forks.rs
      }
      storage = component "Workspace persistence and record codecs" {
        #implemented
        summary "Versioned encrypted records, slots and atomic SQLite transactions."
        description "Current adapter-owned typed records and explicit version/kind wrappers; bundled SQLite objects/slots and authoritative receipts; generation/head checks, bounded consistent read views and WAL/FULL publication. Schema1/2 ordinary opening remains separate from disposable experimental schema3 records. Not every index is reconstructible. No new schema/envelope/API version, pruning or real-data format acceptance follows from this diagram."
        metadata { authority "proposed architectural grouping" implementation "implemented" paths ["backend/crates/storage/src/lib.rs", "backend/crates/storage/src/encoding.rs"] }
        link ../../04-architecture/data-architecture.md
        link ../../04-architecture/decisions/0006-domain-serialization-boundary.md
        link ../../04-architecture/decisions/0007-explicit-record-versions.md
        link ../../07-implementation/data-structures/sqlite-records.md
        link ../../../backend/crates/storage/src/lib.rs
        link ../../../backend/crates/storage/src/encoding.rs
      }
      recovery = component "Integrity audit and recovery boundaries" {
        #partial
        summary "Read-only bounded audit and backed-up enrollment; wider repair is planned."
        description "Current original-branch immediate-record audit, fail-closed decoding, durable draft/receipt recovery and verified backup before explicit keychain upgrade have bounded implementation evidence. Full repair/rebuild/portable restore, power-loss coverage and long-history temporal upgrade remain separate gates. OWNER-009 keeps required persistent application/recovery evidence in the workspace; complete authentic rollback is undetectable and no external witness is introduced."
        metadata { authority "proposed architectural grouping" implementation "partial" paths ["backend/crates/storage/src/audit.rs", "backend/crates/storage/src/lib.rs", "backend/crates/storage/src/keychain.rs"] }
        link ../../08-assurance/recovery.md
        link ../../08-assurance/security-threat-model.md
        link ../../02-governance/OWNER_DECISIONS.md
        link ../../../backend/crates/storage/src/audit.rs
        link ../../../backend/crates/storage/src/lib.rs
        link ../../../backend/crates/storage/src/keychain.rs
      }
      crypto = component "Authenticated envelopes and managed keys" {
        #implemented
        summary "Context-bound encryption, entropy and bounded key wrapping."
        description "Current XChaCha20-Poly1305 object envelopes, Argon2id passphrase/device wrapping, OS randomness, separate ciphertext addresses and zeroizing managed buffers. Expected workspace/kind/identity/generation bindings come from the application. Key rotation, group hierarchy, signatures, selective historical key grants and hostile-host protection are not delivered by byte encryption. Crypto decides no authorization."
        metadata { authority "proposed architectural grouping" implementation "implemented" paths ["backend/crates/crypto/src/lib.rs"] }
        link ../../06-subsystems/interfaces/crypto-adapter.md
        link ../../06-subsystems/formats/crypto-envelopes.md
        link ../../06-subsystems/security-cryptography.md
        link ../../../backend/crates/crypto/src/lib.rs
      }
      keychain = component "Explicit native unlock lifecycle" {
        #partial
        summary "Optional macOS device secret; passphrase recovery retained."
        description "Current explicit status/enroll/unlock/remove, verified schema2 upgrade and checked native-provider cleanup. Device secret, workspace key, human passphrase and TLS key are distinct. No startup enrollment, plaintext fallback or user workspace mutation as a test effect. Non-macOS provider support, rotation and broader lifecycle remain unavailable or gated."
        metadata { authority "proposed architectural grouping" implementation "partial" paths ["backend/crates/keychain/src/lib.rs", "backend/crates/storage/src/keychain.rs"] }
        link ../../04-architecture/decisions/0014-keychain-unlock-policy.md
        link ../../../backend/crates/keychain/src/lib.rs
        link ../../../backend/crates/storage/src/keychain.rs
      }
      transport = component "Startup, HTTPS and API adapters" {
        #implemented
        summary "Loopback TLS, sessions, bounded routing and API1 DTOs."
        description "Current supplied TLS certificate/key, numeric loopback Host, same-origin requests, bounded headers/body/workers/deadlines, launch capability exchange, secure cookie, locked startup, passphrase unlock and command/read routing. Generated OpenAPI3.1 coverage is progressive; route-only bodies remain untyped. The feature-gated schema exporter is development tooling. HPX-OWNER-029 requires one common human/AI command/query API behind browser HTTPS and AI MCP adapters, with per-user-per-workspace authority. These multi-user/MCP mechanisms are incomplete; remote listeners, WSS and general login are not inferred."
        metadata { authority "proposed architectural grouping" implementation "implemented" paths ["backend/crates/runtime/src/main.rs", "backend/crates/runtime/src/api.rs", "backend/crates/runtime/src/api_transport.rs"] }
        link ../../04-architecture/decisions/0004-local-https-bootstrap.md
        link ../../06-subsystems/interfaces/browser-runtime.md
        link ../../../backend/crates/runtime/src/main.rs
        link ../../../backend/crates/runtime/src/api.rs
        link ../../../backend/crates/runtime/src/api_transport.rs
      }
      frontend_assets = component "Embedded frontend resources" {
        #implemented
        summary "Static browser assets served from the executable."
        description "Generated immutable asset map embeds HTML/CSS/JavaScript and reviewed notices. CodeMirror, KaTeX, editing, Navigator, graph drawing and source/selection/Undo presentation execute in the browser, not as Rust components. Node/esbuild and Lean are build/assurance tools. Planned local spell checking must follow approved packaging and privacy; its native/browser allocation is unselected."
        metadata { authority "proposed architectural grouping" implementation "implemented" paths ["backend/crates/runtime/build.rs", "frontend/build.mjs", "frontend/src/app.js"] }
        link ../../01-purpose/scope-and-non-goals.md
        link ../../06-subsystems/frontend-interaction.md
        link ../../../backend/crates/runtime/build.rs
        link ../../../frontend/build.mjs
        link ../../../frontend/src/app.js
      }
      integrations = component "External integration adapters (planned)" {
        #planned
        summary "Scoped agent, citations, import/export, GitHub and federation adapters."
        description "Specified future integration responsibilities within the native application boundary, not selected services, vendors, endpoints, persistence formats or converter processes. Every execution rechecks current authorization and confidentiality/egress policy; client-held/non-trusted plaintext egress remains denied. C3 summarizes these planned adapters; their detailed source-linked responsibilities remain in the model."
        metadata { authority "proposed architectural grouping" implementation "planned" }
        link ../../06-subsystems/external-integrations.md
        link ../../06-subsystems/import-export.md
        link ../../06-subsystems/security-cryptography.md
        agents = component "Machine-user chat adapter" {
          #planned
          summary "Required chat nodes and workspace-user permissions; no inference orchestration."
          description "AI agents are a user kind;one machine user per provider per workspace, with workspace-local identity and permissions. Multiple providers may share a workspace. Chat prompts/all supplied context/responses must be nodes with history/provenance. MCP selected-node edits enter through user client access and common application policy,not a universal proposal-only path. Output/selection never self-grants authority. HPX records chat/context nodes and applies shared user API permissions; the machine user performs inference externally. No HPX inference endpoint or model-call service is required. Identity/chat records remain unselected."
          metadata { authority "proposed architectural grouping" implementation "planned" }
          link ../../03-requirements/user-needs.md
          link ../../03-requirements/system-requirements.md
          link ../../06-subsystems/security-cryptography.md
        }
        citations = component "Zotero citation adapters" {
          #planned
          summary "Separate desktop-local and cloud read-only access."
          description "Separately selected/authenticated desktop REST and cloud Web API interfaces. Capture exact bibliographic metadata and style resources for reconstruction; no write-back, live historical refresh or automatic fallback. Credentials/origins/contracts remain open."
          metadata { authority "proposed architectural grouping" implementation "planned" }
          link ../../06-subsystems/document-engine.md
          link ../../06-subsystems/import-export.md
        }
        word_import = component "Document and Word-review import" {
          #planned
          summary "Bound untrusted parsing and produce a reviewed exact import plan."
          description "Exact base/target, source-file digest, change/comment mappings and ambiguity diagnostics precede authorization/publication. Retain Word Revision attribution and separate importing/approving humans. No macro execution, remote resource fetching, guessed matching, parser package or portable format selected."
          metadata { authority "proposed architectural grouping" implementation "planned" }
          link ../../06-subsystems/external-integrations.md
        }
        export = component "Frozen export and academic compilation" {
          #planned
          summary "Authorized exact content, citations, supplements and rights reports."
          description "Freeze branch/snapshot or acknowledged draft, complete permitted closure, overlays/roles, bibliographic/style resources and target profile. Preserve Markdown/PDF/HTML obligations and RQ-030 docx/odt/rtf/html/tex/typ/xml/json targets, with declared fallbacks and permitted unresolved-rights appendix. Bundled/embedded Pandoc mechanism is open; no standalone runtime helper is selected. Exact temporary Markdown download remains a browser function."
          metadata { authority "proposed architectural grouping" implementation "planned" }
          link ../../06-subsystems/import-export.md
          link ../../03-requirements/user-needs.md
          link ../../06-subsystems/external-integrations.md
        }
        github_jobs = component "GitHub jobs, backup and update adapter" {
          #planned
          summary "Separate reviewed publication, encrypted backup and release discovery."
          description "Frozen approved inputs, exact remote concurrency conditions and durable encrypted job/outbox outcomes must reconcile unknown results without promising exactly-once writes. Create-only encrypted backup/restore and release authenticity, installation origin, explicit install/restart approval remain separately gated. No provider connection, remote format, automatic updater or artifact-signing protocol is selected."
          metadata { authority "proposed architectural grouping" implementation "planned" }
          link ../../06-subsystems/external-integrations.md
        }
        federation = component "Peer exchange and synchronization adapter" {
          #planned
          summary "Future authorized offline exchange and coediting interfaces."
          description "Future cross-instance operation validation, exact context, membership/revocation, causal ordering and deterministic conflict handling must preserve common application semantics and retained history. TLS/SQLite/CRDT alone establish none of these. No MLS, network topology, replication protocol or client-held executor is adopted."
          metadata { authority "proposed architectural grouping" implementation "planned" }
          link ../../03-requirements/system-requirements.md
          link ../../06-subsystems/security-cryptography.md
          link ../../02-governance/roadmap.md
        }
      }
    }
  }
