  // Overview aggregation of already specified protected query handlers.
  // This is not a second command path or a call through Workspace::execute.
  hpx.native.transport -[native_call]-> hpx.native.application "Protected read services (area summary)" {
    metadata { evidence "docs/04-architecture/component-architecture.md" scope "C3 application-area summary of existing document/graph/history/annotation/audit reads, not Workspace::execute" }
    link ../../04-architecture/component-architecture.md
