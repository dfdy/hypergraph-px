views {
  view c4_api_routes of hpx.native.transport.api {
    title "C4 / API dispatch and wire adapters — Implementation (shared)"
    description "Code-linked branch groups, not new modules: all handlers are fragments of route_inner. Exact routes/methods/payloads stay in OpenAPI. Click bootstrap/lifecycle for Unlock; publication branch for Commit; Workspace publication for Save; browser protocol for uncertain outcome. Partial schema coverage is independent of bounded code implementation. Blue/grey and fixed status badges match C2. Static connectors are smooth curves; sequences use UML message rendering."
    // Presentation boundary for the focal responsibility;shared code remains co-located as evidenced.
    group "API dispatch and wire adapters" { color primary; border solid
      group "Wire conversion" { color primary; border solid
        include hpx.native.transport.api.c4_decode with { description "Branch-local DTO/Id decoding. Preserve ignored bodies; schema coverage is partial." }
        include hpx.native.transport.api.c4_command_codec with { description "Lossless typed Fork conversion plus existing legacy command codecs." }
      }
      group "Route families — shared route_inner function" { color primary; border solid
        include hpx.native.transport.security.c4_bootstrap with { description "1 existing routes in the shared route_inner function. Exact wire contract linked." }
        include hpx.native.transport.lifecycle.c4_lifecycle with { description "7 existing routes in the shared route_inner function. Exact wire contract linked." }
        include hpx.native.transport.api.c4_documents with { description "2 existing routes in the shared route_inner function. Exact wire contract linked." }
        include hpx.native.transport.api.c4_history with { description "10 existing routes in the shared route_inner function. Exact wire contract linked." }
        include hpx.native.transport.api.c4_graph with { description "3 existing routes in the shared route_inner function. Exact wire contract linked." }
        include hpx.native.transport.api.c4_annotations with { description "4 existing routes in the shared route_inner function. Exact wire contract linked." }
        include hpx.native.transport.api.c4_working with { description "7 existing routes in the shared route_inner function. Exact wire contract linked." }
        include hpx.native.transport.api.c4_publication with { description "2 existing routes in the shared route_inner function. Exact wire contract linked." }
      }
    }
    // Callers,providers,artifacts and consumers stay outside the focal boundary.
    include hpx.browser.c4_protocol with { description "Freeze owned requests, serialize edits and validate receipts. Pending state is tab-local." }
    include hpx.native.authority.c4_checks with { description "Current catalog/command/outcome scope. Reauthorize before protected replay." }
    include hpx.native.storage.c4_annotations with { description "assertion_page / assertion_revision / comments_page / publication_contributors." }
    include hpx.native.storage.c4_documents with { description "Workspace::list_documents / open_document; current authorized editor state." }
    include hpx.native.storage.c4_graph with { description "document_fork_graph / overlay_graph / transformation_graph; scoped read projections." }
    include hpx.native.storage.c4_history with { description "Branch/history/snapshot/anchor readers and bounded audit. All real methods are source-linked." }
    include hpx.native.storage.c4_lifecycle with { description "Workspace create/open/keychain/status methods. Lock itself sets State.workspace=None." }
    include hpx.native.storage.c4_publication with { description "Workspace::execute / execute_inner / receipt. Current authority, digest and atomic result." }
    include hpx.native.storage.c4_working with { description "Protected clipboard and source/derivation readers. Merge-named read is not publication." }
    include hpx.native.transport.security.c4_compare with { description "Actual launch-token comparison helper; cookie construction stays in route_inner." }
    include hpx.native.transport.security.c4_gates with { description "Actual Host/Origin, cookie and lock guards. Resource authority stays below transport." }
    style * { color primary }
    style element.tag = #planned { color muted; border dashed }
    exclude * -> *
    include * -> * where kind is code_call
    include hpx.native.transport.security.c4_bootstrap with { navigateTo seq_unlock }
    include hpx.native.transport.lifecycle.c4_lifecycle with { navigateTo seq_unlock }
    include hpx.native.transport.api.c4_publication with { navigateTo seq_commit }
    include hpx.native.storage.c4_publication with { navigateTo seq_save }
    include hpx.browser.c4_protocol with { navigateTo seq_uncertain }
    exclude * -> * where kind is delivery_build
    exclude * -> * where kind is delivery_call
    exclude * -> * where kind is delivery_code
    exclude * -> * where kind is domain_use
    exclude * -> * where kind is domain_call
    exclude * -> * where kind is domain_type
    exclude * -> * where kind is domain_test
    exclude * -> * where kind is coverage_call
    exclude * -> * where kind is coverage_data
    exclude * -> * where kind is coverage_plan
    exclude * -> * where kind is delivery_detail_call
    exclude * -> * where kind is delivery_detail_data
    exclude * -> * where kind is delivery_detail_build
    exclude * -> * where kind is coordination_call
    exclude * -> * where kind is coordination_control
    exclude * -> * where kind is coordination_data
    exclude * -> * where kind is coordination_result
    autoLayout LeftRight 100 90 spline
  }
}
