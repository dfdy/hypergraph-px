views {
 view c4_application_transaction of hpx.native.application.admission {
 title "C4 / Command admission and transaction scope — Implementation (shared)"
 description "Primary parent: Command admission and transaction scope. Shared contributors: Original operation and receipt reconciliation; Atomic outcome and receipt publication. Workspace execute/execute_inner/receipt share existing code; no application crate/dispatcher service is introduced. Input: decoded Command/operation plus trusted workspace identity. Output: receipt/error, not delivery acknowledgement. Solid calls/control; dotted type/data/returns."
 link ../audits/application-coordination-audit.md
    // Presentation boundary for the focal responsibility;shared code remains co-located as evidenced.
    group "Command admission and transaction scope" { color primary; border solid
      include hpx.native.storage.c4_publication with { navigateTo seq_application_transaction }
      include hpx.native.application.admission.validation_code with { navigateTo seq_application_transaction }
      include hpx.native.application.replay.records_code with { navigateTo seq_uncertain }
      include hpx.native.application.dispatch.match_code with { navigateTo c4_application_features }
    }
    // Callers,providers,artifacts and consumers stay outside the focal boundary.
    include hpx.native.authority.c4_checks with { navigateTo seq_application_transaction }
    include hpx.native.storage.coordination_records with { navigateTo c3_workspace_persistence }
    include hpx.native.transport.api.c4_publication with { navigateTo c4_api_routes }
 style * { color primary }
 style element.tag = #planned { color muted; border dashed }
 exclude * -> *
 include hpx.native.transport.api.c4_publication -> hpx.native.storage.c4_publication where kind is coordination_call
 include hpx.native.storage.c4_publication -> hpx.native.application.admission.validation_code where kind is coordination_call
 include hpx.native.storage.c4_publication -> hpx.native.application.replay.records_code where kind is coordination_data
 include hpx.native.storage.c4_publication -> hpx.native.authority.c4_checks where kind is coordination_call
 include hpx.native.storage.c4_publication -> hpx.native.storage.coordination_records where kind is coordination_call
 include hpx.native.storage.c4_publication -> hpx.native.application.dispatch.match_code where kind is coordination_control
 include hpx.native.storage.c4_publication -> hpx.native.transport.api.c4_publication where kind is coordination_data
 autoLayout LeftRight 110 100 spline
 }
 view c4_application_features of hpx.native.application.dispatch {
 title "C4 / Feature operation coordination — Implementation (shared)"
 description "Primary parent: Feature operation coordination. Shared contributors: documents/branches, derivation/contributors, private references, assertions and comments from the C3 context. Actual helper groups and same-function match fragment; all 13 Command variants are mapped in the linked inventory. Input: new authorized operation plus borrowed writer transaction. Output: Outcome/error to execute_inner; helper effects stay staged until receipt COMMIT. Pure planners do not authorize or publish. Independent Synthesis is not parent Merge."
 link ../audits/application-coordination-audit.md
    // Presentation boundary for the focal responsibility;shared code remains co-located as evidenced.
    group "Feature operation coordination" { color primary; border solid
      group "Command match" { color primary; border solid
        include hpx.native.application.dispatch.match_code with { navigateTo seq_application_transaction }
      }
      group "Editing and independent derivation" { color primary; border solid
        include hpx.native.storage.coordination_documents with { navigateTo seq_commit }
        include hpx.native.storage.coordination_branches with { navigateTo seq_save }
        include hpx.native.storage.domain_forks with { navigateTo seq_domain_fork }
        include hpx.native.storage.domain_merges with { navigateTo c4_domain_sources }
      }
      group "Private references and annotations" { color primary; border solid
        include hpx.native.storage.domain_working with { navigateTo seq_application_checkpoint }
        include hpx.native.storage.coordination_working_forks with { navigateTo seq_application_checkpoint }
        include hpx.native.storage.coordination_private_refs with { navigateTo seq_application_checkpoint }
        include hpx.native.storage.domain_assertions with { navigateTo c4_domain_sources }
        include hpx.native.storage.domain_comments with { navigateTo c4_domain_sources }
      }
    }
    // Callers,providers,artifacts and consumers stay outside the focal boundary.
    include hpx.native.domain with { title "Pure domain" navigateTo c3_pure_domain }
    include hpx.native.storage.c4_publication with { navigateTo c4_application_transaction }
    include hpx.native.storage.coordination_records with { navigateTo c3_workspace_persistence }
    include hpx.native.storage.domain_trace_driver with { title "Experimental temporal helpers (schema3 only)" description "Inputs: frozen temporal request and guarded experimental workspace fixture. Outputs: lineage/receipt/state or error. Separate temporal_save/temporal_commit helpers; no normal opener, upgrade or runtime route." navigateTo c4_domain_history }
 style * { color primary }
 style element.tag = #planned { color muted; border dashed }
 exclude * -> *
 include hpx.native.application.dispatch.match_code -> hpx.native.storage.coordination_documents where kind is coordination_call
 include hpx.native.application.dispatch.match_code -> hpx.native.storage.coordination_branches where kind is coordination_call
 include hpx.native.application.dispatch.match_code -> hpx.native.storage.domain_forks where kind is coordination_call
 include hpx.native.application.dispatch.match_code -> hpx.native.storage.domain_merges where kind is coordination_call
 include hpx.native.application.dispatch.match_code -> hpx.native.storage.domain_working where kind is coordination_call
 include hpx.native.application.dispatch.match_code -> hpx.native.storage.coordination_working_forks where kind is coordination_call
 include hpx.native.application.dispatch.match_code -> hpx.native.storage.coordination_private_refs where kind is coordination_call
 include hpx.native.application.dispatch.match_code -> hpx.native.storage.domain_assertions where kind is coordination_call
 include hpx.native.application.dispatch.match_code -> hpx.native.storage.domain_comments where kind is coordination_call
 include hpx.native.application.dispatch.match_code -> hpx.native.storage.coordination_records where kind is coordination_data
 include hpx.native.application.dispatch.match_code -> hpx.native.storage.c4_publication where kind is coordination_data
 include hpx.native.storage.coordination_documents -> hpx.native.domain where kind is coordination_data
 include hpx.native.storage.domain_forks -> hpx.native.domain where kind is coordination_call
 include hpx.native.storage.domain_merges -> hpx.native.domain where kind is coordination_call
 include hpx.native.storage.c4_publication -> hpx.native.application.dispatch.match_code where kind is coordination_control with { title "Authorized Command + transaction" }
 include hpx.native.storage.domain_trace_driver -> hpx.native.storage.coordination_records where kind is coordination_data
 autoLayout LeftRight 110 100 spline
 }
 view c4_application_reads of hpx.native.application.reads {
 title "C4 / Protected read entry points — Implementation"
 description "Parent: Protected read entry points. Runtime directly calls existing Workspace query families; API contracts retain exact methods/payloads. No execute path/common read facade is invented. Inputs: current unlocked identity and family-specific query arguments;read budgets are enforced by each method. Outputs: method-specific authenticated results/errors; history example is explicit. Receipts query the original result but recheck current outcome scope. Method-local transactions/limits differ; authority context edge is not one shared call. Queries do not grant mutation or historical key rights."
 link ../audits/application-coordination-audit.md
    // Presentation boundary for the focal responsibility;shared code remains co-located as evidenced.
    group "Protected read entry points" { color primary; border solid
      include hpx.native.storage.c4_documents with { navigateTo seq_application_read }
      include hpx.native.storage.c4_history with { navigateTo seq_application_read }
      include hpx.native.storage.c4_graph with { navigateTo c4_api_routes }
      include hpx.native.storage.c4_annotations with { navigateTo c4_api_routes }
      include hpx.native.storage.c4_working with { navigateTo seq_application_checkpoint }
      include hpx.native.storage.c4_publication with { title "Workspace::receipt • protected original outcome" description "Receipt-only projection of reused Workspace alias; command execution belongs to the shared transaction view." navigateTo seq_uncertain }
    }
    // Callers,providers,artifacts and consumers stay outside the focal boundary.
    include hpx.native.authority with { navigateTo c4_application_transaction }
    include hpx.native.storage.coordination_records with { navigateTo c3_workspace_persistence }
    include hpx.native.transport.api with { navigateTo c4_api_routes }
 style * { color primary }
 style element.tag = #planned { color muted; border dashed }
 exclude * -> *
 include hpx.native.transport.api -> hpx.native.storage.c4_documents where kind is coordination_control
