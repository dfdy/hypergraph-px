// Proposed code projections of existing Workspace responsibilities, not new Rust boundaries.
specification {
 relationship coordination_call { line solid; color slate }
 relationship coordination_control { line solid; color slate }
 relationship coordination_data { line dotted; color slate }
 relationship coordination_result { line dotted; color slate }
}
model {
 extend hpx.native.application.admission { validation_code = code "validate_command • bounded command admission" {
 #implemented
 description "Existing validator delegates feature validation and checks bounded text/title/generation/sequence inputs. Serialization/digest happens in storage adapter execute_inner, not the pure domain."
 metadata { authority "proposed source fragment grouping;not new Rust modules or adopted V3 design" implementation "implemented" paths ["crates/storage/src/lib.rs"] symbols ["validate_command", "Command"] spec_refs "HPX-PROTO-001 §4 planned mutation/recovery and §5 draft acknowledgement;current owner decisions qualify retained wording" }
 link ../../crates/storage/src/lib.rs
 link ../../docs/07-implementation/protocols/draft-publication.md
 link ../../docs/06-subsystems/interfaces/domain-navigation.md
 } }
 extend hpx.native.application.replay { records_code = code "Command / Outcome / Receipt / StoredReceipt" {
 #implemented
 description "Actual adapter-owned command/result/receipt data; StoredReceipt binds serialized Command digest to original outcome. This is type evidence, not another receipt store or a new wire/persistence format."
 metadata { authority "proposed source fragment grouping;not new Rust modules or adopted V3 design" implementation "implemented" paths ["crates/storage/src/lib.rs"] symbols ["Command", "Outcome", "Receipt", "StoredReceipt"] spec_refs "HPX-PROTO-001 §§4–6 original operation,draft ACK,immutable Commit;not a new wire format" }
 link ../../crates/storage/src/lib.rs
 link ../../docs/07-implementation/protocols/draft-publication.md
 link ../../docs/06-subsystems/interfaces/domain-navigation.md
 } }
 extend hpx.native.application.dispatch { match_code = code "execute_inner • Command match" {
 #implemented
 description "Actual match fragment in the same execute_inner function. Delegates 13 Command variants; returns Outcome/state to caller-owned writer transaction. Branch control is not a new dispatcher function."
 metadata { authority "proposed source fragment grouping;not new Rust modules or adopted V3 design" implementation "implemented" paths ["crates/storage/src/lib.rs"] symbols ["execute_inner"] }
 link ../../crates/storage/src/lib.rs
 link ../../docs/07-implementation/protocols/draft-publication.md
 link ../../docs/06-subsystems/interfaces/domain-navigation.md
 } }
 extend hpx.native.storage { coordination_records = code "Cipher • authenticated object and slot operations" {
 #implemented
 description "Existing encrypted record/slot operations on supplied Connection/Transaction. Helpers stage effects; transaction commit belongs to execute_inner. Records/codecs and crypto are adapters outside the dependency-free pure domain."
 metadata { authority "proposed source fragment grouping;not new Rust modules or adopted V3 design" implementation "implemented" paths ["crates/storage/src/lib.rs"] symbols ["Cipher", "object", "insert", "slot", "update"] }
 link ../../crates/storage/src/lib.rs
 link ../../docs/07-implementation/protocols/draft-publication.md
 link ../../docs/06-subsystems/interfaces/domain-navigation.md
 } }
 extend hpx.native.storage { coordination_documents = code "create_document / write_draft / publish_revision" {
 #implemented
 description "Existing original-document creation, mutable Save and single-parent Commit. Commit constructs retained exact one-binding snapshot and event, updates head/draft and promotes matching private checkpoints; Save publishes no immutable revision."
 metadata { authority "proposed source fragment grouping;not new Rust modules or adopted V3 design" implementation "implemented" paths ["crates/storage/src/lib.rs"] symbols ["create_document", "write_draft", "publish_revision"] }
 link ../../crates/storage/src/lib.rs
 link ../../docs/07-implementation/protocols/draft-publication.md
 link ../../docs/06-subsystems/interfaces/domain-navigation.md
 } }
 extend hpx.native.storage { coordination_branches = code "branches • validate / authorize / apply" {
 #implemented
 description "Existing original/child branch operations; typed document/branch authority checked before receipt replay, mutable generations checked only for a new operation. Not general composition or two-parent publication."
 metadata { authority "proposed source fragment grouping;not new Rust modules or adopted V3 design" implementation "implemented" paths ["crates/storage/src/branches.rs"] symbols ["validate", "authorize", "apply"] }
 link ../../crates/storage/src/branches.rs
 link ../../docs/07-implementation/protocols/draft-publication.md
 link ../../docs/06-subsystems/interfaces/domain-navigation.md
 } }
 extend hpx.native.storage { coordination_working_forks = code "working_forks • validate / apply" {
 #implemented
 description "Existing fork from an exact private working checkpoint; independent new identity/provenance, not same-node ancestry or an implicit source Commit."
 metadata { authority "proposed source fragment grouping;not new Rust modules or adopted V3 design" implementation "implemented" paths ["crates/storage/src/working_forks.rs"] symbols ["validate", "apply"] }
 link ../../crates/storage/src/working_forks.rs
 link ../../docs/07-implementation/protocols/draft-publication.md
 link ../../docs/06-subsystems/interfaces/domain-navigation.md
 } }
 extend hpx.native.storage { coordination_private_refs = code "clipboard / working_clipboard • capture and mutations" {
 #implemented
 description "Existing private committed and working reference mutations; WorkingCopy atomically stages checkpoint plus private reference. Reference capture/clipboard publication is not immutable text Commit."
 metadata { authority "proposed source fragment grouping;not new Rust modules or adopted V3 design" implementation "implemented" paths ["crates/storage/src/clipboard.rs", "crates/storage/src/working_clipboard.rs"] symbols ["validate", "authorize", "apply", "capture"] }
 link ../../crates/storage/src/clipboard.rs
 link ../../crates/storage/src/working_clipboard.rs
 link ../../docs/07-implementation/protocols/draft-publication.md
 link ../../docs/06-subsystems/interfaces/domain-navigation.md
 } }
