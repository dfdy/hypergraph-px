// Conceptual operation effects only;application authority/persistence remains outside the pure domain.
views {
  dynamic view seq_concept_evidence {
    variant sequence
    title "Conceptual effects / Retained source, review and observed exchanges"
    description "O3 / HPX-CAN-024. Independent adopted/source-scoped effect cases using existing conceptual roles;not pure-domain I/O,software calls,wire timing or a selected record scheme. Current authority,exact owned source and original-operation reconciliation remain mandatory. ADR019/010 adoption is distinct from bounded implementation;machine-user chat/MCP requirements do not imply delivered capture or permission formats."
    link ../C3/pure-domain.c4
    link ../../docs/04-architecture/decisions/0019-working-branches-and-reference-checkpoints.md
    link ../../docs/04-architecture/decisions/0010-semantic-annotation-snapshots.md
    link ../../docs/06-subsystems/ai-collaboration.md
    alt "Distinct retained-evidence operations" {
      when "Explicit provenance-bearing source capture" {
        hpx.native.domain.source_plans.concept_draft -> hpx.native.domain.source_plans.concept_draft "Capture exact owner/base/generation/sequence/range;settle earlier uncertain intent;retain newer typing"
        hpx.native.domain.source_plans.concept_draft -> hpx.native.domain.source_plans.concept_checkpoint "Authorised transaction captures/reuses exact immutable unpublished source;ordinary autosave is not this operation"
        hpx.native.domain.source_plans.concept_checkpoint -> hpx.native.domain.source_plans.concept_checkpoint "Reference pins checkpoint/range/context,not moving head;acknowledge only durable outcome;unknown reply reconciles original intent"
      }
      when "Later exact promotion" {
        hpx.native.domain.source_plans.concept_checkpoint -> hpx.native.domain.source_plans.concept_promotion "Exact later Commit may establish immutable correspondence;no automatic relocation or link rewriting"
        hpx.native.domain.source_plans.concept_promotion -> hpx.native.domain.exact.concept_revision "Retain exact committed result;authorised replacement is separate from promotion"
      }
      when "Assertion creation/review under ADR010" {
        hpx.native.domain.annotation_rules.concept_assertion -> hpx.native.domain.annotation_rules.concept_assertion "Authorised changes append attributed revisions/review state;retain rejected/superseded claims;do not infer truth"
        hpx.native.domain.annotation_rules.concept_assertion -> hpx.native.domain.annotation_rules.concept_overlay "Select exact retrospective annotation context;never insert later claims into old text snapshots"
      }
      else "Observable machine-user exchange" {
        hpx.native.domain.source_plans.concept_interaction -> hpx.native.domain.exact.concept_node "Retain exact supplied prompts/context and observed responses through ordinary authorised workspace semantics"
        hpx.native.domain.source_plans.concept_interaction -> hpx.native.domain.source_plans.concept_interaction "Record partial/failed/cancelled observations honestly;do not claim unavailable provider-internal context"
        hpx.native.domain.source_plans.concept_evidence -> hpx.native.domain.source_plans.concept_interaction "Observed/declared/inferred evidence stays distinct;adoption is not verification,authorship or endorsement"
        hpx.native.domain.source_plans.concept_interaction -> hpx.native.domain.source_plans.concept_contribution "An exchange may yield a contribution;observation itself grants no permission or automatic edits"
      }
    }
  }
}
