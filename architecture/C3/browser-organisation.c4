// Canonical definition location: HPX-CAN-004 (HPX-OWNER-032). Existing design/implementation statuses retain their authority; see architecture/SPECIFICATION.md.
// Presentation/function projections over shared code. No implementation refactor.
specification { relationship graph_tab_design { #planned; line dashed; color muted } relationship browser_organisation { line solid; color slate } relationship browser_presentation { line solid; color slate } }
model {
 extend hpx.browser {
  ui = component "User interface" {
   #partial
   description "Visible panels, editor surface, Navigator, controls and status. Existing runtime UI coexists with explicitly synthetic/gated features. Open the User interface C3 expansion."
   metadata { authority "owner-requested modelling split;not a new module" execution "browser" implementation "partial" paths ["frontend/index.html", "frontend/src/app.js"] }
   link ../../docs/06-subsystems/frontend-interaction.md
   link ../../frontend/index.html
   link ../../frontend/src/app.js
   contents = component "Workspace and contents navigation" {
    #partial
    description "Workspace/document lenses and heading tree; broader collection/graph/history lenses include partial or synthetic scope."
    metadata { authority "source-backed UI region;not a new module" execution "browser" implementation "partial" paths ["frontend/index.html", "frontend/src/app.js", "frontend/src/outline-tree.js"] symbols ["navigation"] spec_refs "HPX-SUB-009 desktop presentation and desktop workspace" }
    link ../../docs/06-subsystems/frontend-interaction.md
    link ../../frontend/index.html
    link ../../frontend/src/app.js
    link ../../frontend/src/outline-tree.js
   }
   editor = component "Document editor" {
    #implemented
    description "Existing CodeMirror document surface and rendered/source presentation. Editing rules and exact source coordination belong to Interface functions."
    metadata { authority "source-backed UI region;not a new module" execution "browser" implementation "implemented" paths ["frontend/index.html", "frontend/src/app.js", "frontend/src/inline-presentation.js"] symbols ["editorHost"] spec_refs "HPX-SUB-009 desktop presentation and desktop workspace" }
    link ../../docs/06-subsystems/frontend-interaction.md
    link ../../frontend/index.html
    link ../../frontend/src/app.js
    link ../../frontend/src/inline-presentation.js
   }
   navigator = component "Navigator (minimap)" {
    #implemented
    description "Visible mini-overview and viewport control. Scrolling, geometry and preference coordination are functions, not a second text source."
    metadata { authority "source-backed UI region;not a new module" execution "browser" implementation "implemented" paths ["frontend/index.html", "frontend/src/minimap.js"] symbols ["documentNavigator", "mapViewport"] spec_refs "HPX-SUB-009 desktop presentation and desktop workspace" }
    link ../../docs/06-subsystems/frontend-interaction.md
    link ../../frontend/index.html
    link ../../frontend/src/minimap.js
   }
   interaction = component "Interaction panel" {
    #partial
    description "Agent,Comments and Users tabs. Multiple AI users and node-based chat are mandatory baseline;current agent chat is mock/unavailable. Contributor records remain distinct from presence/membership."
    metadata { authority "source-backed UI region;not a new module" execution "browser" implementation "partial" paths ["frontend/index.html", "frontend/src/app.js", "frontend/src/runtime-comments-panel.js", "frontend/src/runtime-contributors.js"] symbols ["interaction", "interactionBody"] spec_refs "HPX-SUB-009 desktop presentation and desktop workspace" }
    link ../../docs/06-subsystems/frontend-interaction.md
    link ../../frontend/index.html
    link ../../frontend/src/app.js
    link ../../frontend/src/runtime-comments-panel.js
    link ../../frontend/src/runtime-contributors.js
   }
   investigation = component "Investigation panel" {
    #partial
    description "Relationships, Concepts, Sources, Provenance and History tabs with capability/scope limits. Rich concept/source examples and general graph scope remain partial."
    metadata { authority "source-backed UI region;not a new module" execution "browser" implementation "partial" paths ["frontend/index.html", "frontend/src/app.js", "frontend/src/history-panel.js", "frontend/src/runtime-assertions-panel.js"] symbols ["investigation", "investigationBody"] spec_refs "HPX-SUB-009 desktop presentation and desktop workspace" }
    link ../../docs/06-subsystems/frontend-interaction.md
    link ../../frontend/index.html
    link ../../frontend/src/app.js
    link ../../frontend/src/history-panel.js
    link ../../frontend/src/runtime-assertions-panel.js
   }
   controls = component "Shared controls and status" {
    #partial
    description "Functions/formatting controls, display settings, menus, dialogs and status feedback. Fork/Link and draft/Commit actions exist; general Embed remains gated."
    metadata { authority "source-backed UI region;not a new module" execution "browser" implementation "partial" paths ["frontend/index.html", "frontend/src/app.js", "frontend/src/functions-bar.js", "frontend/src/tooltips.js"] symbols ["forkSelection", "embedSelection", "draftStatus", "toast"] spec_refs "HPX-SUB-009 desktop presentation and desktop workspace" }
    link ../../docs/06-subsystems/frontend-interaction.md
    link ../../frontend/index.html
    link ../../frontend/src/app.js
    link ../../frontend/src/functions-bar.js
    link ../../frontend/src/tooltips.js
   }
  }
  functions = component "Interface functions" {
   #partial
   description "Shared navigation/display, exact editing, workspace access, runtime coordination and inspection/provenance functions. Existing six responsibility IDs are retained in the focused C3 expansion; no code is moved."
   metadata { authority "owner-requested logical grouping;existing responsibilities remain co-located" execution "browser" implementation "partial" members ["hpx.browser.shell", "hpx.browser.access", "hpx.browser.editor", "hpx.browser.coordination", "hpx.browser.history", "hpx.browser.annotations"] paths ["frontend/src/app.js", "frontend/src/runtime-adapter.js"] }
   link ../../docs/06-subsystems/frontend-interaction.md
   link ../../docs/06-subsystems/interfaces/browser-runtime.md
   link ../../frontend/src/app.js
   link ../../frontend/src/runtime-adapter.js
  }
 }
 user -[browser_organisation]-> hpx.browser.ui "Actions / selections / navigation" {
  metadata { authority "source-backed view aggregation;not a new runtime boundary or contract" }
  link ../../frontend/src/app.js
 }
 hpx.browser.ui -[browser_organisation]-> user "Rendered interface / status / errors" {
  metadata { authority "source-backed view aggregation;not a new runtime boundary or contract" }
  link ../../frontend/src/app.js
 }
 hpx.native.frontend_assets -[browser_organisation]-> hpx.browser.ui "Embedded frontend assets (UI and functions)" {
  metadata { authority "source-backed view aggregation;not a new runtime boundary or contract" }
  link ../../crates/runtime/build.rs
 }
 hpx.browser.ui -[browser_organisation]<-> hpx.browser.functions "UI intents / exact context / view state / feedback" {
  metadata { authority "source-backed view aggregation;not a new runtime boundary or contract" }
  link ../../frontend/src/app.js
 }
 hpx.browser.functions -[browser_organisation]<-> hpx.native.transport "Session / unlock; protected requests / results" {
  metadata { authority "source-backed view aggregation;not a new runtime boundary or contract" }
  link ../../frontend/src/runtime-adapter.js
 }
 hpx.browser.functions -[browser_organisation]<-> os_clipboard "Exact-source copy / paste" {
  metadata { authority "source-backed view aggregation;not a new runtime boundary or contract" }
  link ../../frontend/src/owned-source.js
 }
 hpx.browser.functions -[browser_organisation]-> exchange_files "Exact uncommitted Markdown download" {
  metadata { authority "source-backed view aggregation;not a new runtime boundary or contract" }
  link ../../frontend/src/app.js
 }
 hpx.browser.ui -[browser_presentation]-> hpx.browser.shell "UI actions / view context / selection" {
  metadata { authority "source-backed view aggregation;not a new runtime boundary or contract" }
  link ../../frontend/src/app.js
 }
 hpx.browser.shell -[browser_presentation]-> hpx.browser.ui "Coordinated display / status / errors" {
  metadata { authority "source-backed view aggregation;not a new runtime boundary or contract" }
  link ../../frontend/src/app.js
 }
 hpx.browser.ui.contents -[browser_presentation]<-> hpx.browser.functions "Navigation / geometry / preferences" {
  metadata { authority "source-backed view aggregation;not a new runtime boundary or contract" }
  link ../../frontend/src/app.js
 }
 hpx.browser.ui.navigator -[browser_presentation]<-> hpx.browser.functions "Navigation / geometry / preferences" {
  metadata { authority "source-backed view aggregation;not a new runtime boundary or contract" }
  link ../../frontend/src/app.js
 }
 hpx.browser.ui.editor -[browser_presentation]<-> hpx.browser.functions "Exact source projection / edits / selection" {
  metadata { authority "source-backed view aggregation;not a new runtime boundary or contract" }
  link ../../frontend/src/app.js
 }
 hpx.browser.ui.interaction -[browser_presentation]<-> hpx.browser.functions "Comment / contributor context / results" {
  metadata { authority "source-backed view aggregation;not a new runtime boundary or contract" }
  link ../../frontend/src/app.js
 }
 hpx.browser.ui.investigation -[browser_presentation]<-> hpx.browser.functions "Inspection context / scoped results" {
  metadata { authority "source-backed view aggregation;not a new runtime boundary or contract" }
  link ../../frontend/src/app.js
 }
 hpx.browser.ui.controls -[browser_presentation]<-> hpx.browser.functions "Invoked actions / capabilities / status" {
  metadata { authority "source-backed view aggregation;not a new runtime boundary or contract" }
  link ../../frontend/src/app.js
 }
 user -[browser_presentation]<-> hpx.browser.ui.controls "Actions / accessible controls / feedback" {
  metadata { authority "source-backed view aggregation;not a new runtime boundary or contract" }
  link ../../frontend/src/app.js
 }
 hpx.native.frontend_assets -[browser_presentation]-> hpx.browser.ui.controls "HTML / CSS / module bootstrap" {
  metadata { authority "source-backed view aggregation;not a new runtime boundary or contract" }
  link ../../frontend/index.html
 }
 user -[browser_presentation]<-> hpx.browser.ui.contents "Open / select / outline feedback" { link ../../frontend/src/app.js }
 user -[browser_presentation]<-> hpx.browser.ui.editor "Text input / selection / rendered text" { link ../../frontend/src/app.js }
 user -[browser_presentation]<-> hpx.browser.ui.navigator "Viewport navigation / position" { link ../../frontend/src/app.js }
 user -[browser_presentation]<-> hpx.browser.ui.interaction "Panel actions / comments / contributors" { link ../../frontend/src/app.js }
 user -[browser_presentation]<-> hpx.browser.ui.investigation "Inspect / pin / scoped display" { link ../../frontend/src/app.js }
 extend hpx.browser.ui {
  bottom_toolbar = component "Display settings and status" {
   #implemented
   description "Existing display preferences and footer feedback: wrap/font and source/render settings; draft/status/version and counts. Display state is not manuscript persistence or a Commit."
   metadata { authority "source-backed visible region split;not a new module" execution "browser" implementation "implemented" paths ["frontend/index.html", "frontend/src/app.js", "frontend/src/build-version.js"] symbols ["view-controls", "draftStatus", "buildVersion", "position"] spec_refs "HPX-SUB-009 desktop presentation;owner spatial diagram direction" }
   link ../../docs/06-subsystems/frontend-interaction.md
   link ../../frontend/index.html
   link ../../frontend/src/app.js
   link ../../frontend/src/build-version.js
  }
 }
 hpx.browser.ui.bottom_toolbar -[browser_presentation]<-> hpx.browser.functions "Display preferences / draft status / feedback" {
  link ../../frontend/src/app.js
 }
 user -[browser_presentation]<-> hpx.browser.ui.bottom_toolbar "Display settings / status feedback" {
  link ../../frontend/index.html
 }
 extend hpx.browser.ui {
  graph_tab = component "Graph tab (planned)" {
   #planned
   description "Owner-directed editor tab: selected node and its linkages in an interactive visual graph. Same node/view context as the editor; authorised scope and incomplete results remain explicit. Current dialog code is not this tab."
   metadata { authority "HPX-OWNER-026:accepted UI direction;mechanisms remain design work" implementation "planned" spec_refs "HPX-RQ-029;HPX-SUB-001;HPX-SUB-009" current_code "frontend/src/runtime-graph.js implements the existing dialog only" }
   link ../../docs/06-subsystems/frontend-interaction.md#selected-node-graph-tab-owner-direction-2026-10-30
   link ../../docs/06-subsystems/graph-engine.md#selected-node-editor-graph-tab-2026-10-30
  }
 }
 hpx.browser.ui.contents.render -[graph_tab_design]-> hpx.browser.ui.graph_tab "Design: open Graph tab for selected node" { link ../../docs/06-subsystems/frontend-interaction.md#selected-node-graph-tab-owner-direction-2026-10-30 }
 hpx.browser.ui.editor -[graph_tab_design]-> hpx.browser.ui.graph_tab "Node / view (planned)" { link ../../docs/06-subsystems/graph-engine.md#selected-node-editor-graph-tab-2026-10-30 }
 hpx.browser.ui.graph_tab -[graph_tab_design]<-> hpx.browser.functions "Selected node / authorised linkages / interactions (planned)" { link ../../docs/06-subsystems/graph-engine.md#selected-node-editor-graph-tab-2026-10-30 }
 user -[graph_tab_design]<-> hpx.browser.ui.graph_tab "Inspect / select / navigate graph (planned)" { link ../../docs/06-subsystems/frontend-interaction.md#selected-node-graph-tab-owner-direction-2026-10-30 }
}
views {
 view c3_browser_ui of hpx.browser.ui {
  title "C3 / User interface"
  description "Spatial responsibility layout: top/bottom toolbars surround Navigator (left), Editor (centre), and Functions (right). Editor groups planned Text/Graph tabs and the minimap; Functions groups Collaborators above Relations. Names organise the drawing; existing Interaction/Investigation UI labels and shared implementation remain intact. Interface functions, users and asset delivery stay outside the UI boundary. HPX-CAN-014: required HPX-DOM-001 allocation is recorded in view-only notes; current helper coverage is bounded. Precise concepts and unadopted mechanisms remain linked contracts; no conceptual gap is closed by allocation."
  link ../../docs/05-domain/core-object-model.md
  link ../../docs/05-domain/text-and-anchors.md
  link ../../docs/06-subsystems/frontend-interaction.md
  link ../../docs/06-subsystems/interfaces/browser-runtime.md
  link ../../docs/06-subsystems/ai-collaboration.md
  link ../../docs/07-implementation/protocols/draft-publication.md
  link ../audits/browser-interface-c3-audit.md#spatial-user-interface-layout
  include user
  include hpx.native.frontend_assets with { title "Frontend delivery" navigateTo c3_frontend_delivery }
  include hpx.browser.functions with { navigateTo c3_browser_functions }
  group "User interface" {
   group "Top toolbar" {
    include hpx.browser.ui.controls with { title "Actions and formatting" description "Header/action controls, formatting and Fork/Link/Embed controls. Existing shared controls ID; bottom settings/status are shown separately. Unavailable actions remain explicit." }
   }
   group "Navigator (left)" {
    include hpx.browser.ui.contents with { navigateTo c4_workspace_navigation  notes "Display Document/Branch identities and Occurrence placements as distinct contexts;navigation does not change retained historical bindings. Current bounded tree is not full repeated/nested occurrence closure or a conceptual lifecycle model." }
   }
   group "Editor (centre)" {
    include hpx.browser.ui.editor with { description "Existing text editor surface; its shared editor-tab host is planned. Switching views must preserve the same draft, selection and Undo."  notes "Text and alternate projections retain the same logical content/draft,selection and Undo. Exact owner/source mapping is required;no generic multi-owner whole-buffer save or silent Unicode/line-ending normalization. HPX-OWNER-043 requires a toggle for changed-source conflicts: ask before choosing, or choose by latest timestamp and visually mark the affected sentence, paragraph or section as a potential conflict, with a link opening a modal to compare changes. Automatic selection is not proof of conflict resolution or authority and does not imply automatic Commit. HPX-OWNER-044 selects the time HPX recorded each version as committed;equal timestamps ask even in automatic mode. The preference is per workspace user,default Ask. All authorised viewers of the affected committed version see its shared marker until an authorised explicit resolution;opening the comparison modal does not clear it. Timestamp precision/encoding and exact marker/resolution mechanisms remain open. OWNER049 / RQ040 requires a separate source-neutral indication that a newer authorised included-source version is available, while retained A keeps its selected B. The indication is not replacement, a shared potential-conflict marker or permission to expose inaccessible versions;newer comparison is not a global latest-timestamp policy. RQ041 offers saving an authorised constructed current-document version as a specific branch without implicitly Forking. OWNER050 requires restoration from the last acknowledged autosave with exact composition selections and no historical-version accumulation merely per autosave;future universal autosave/Commit separation remains open. Existing private-state visibility and departure Commit are not revoked. General working-composition capture and main designation mechanisms remain open. These controls and general composition remain unimplemented. See the frontend conflict-handling contract and branch reconciliation." }
    include hpx.browser.ui.graph_tab with { notes "Required selected-node projection preserves relationship identity,n-ary participant roles and exact context without implying truth or permission. Existing planned graph-tab block is not a new store,conceptual hyperedge definition or delivered general graph view." }
    include hpx.browser.ui.navigator
   }
   group "Functions (right)" {
    group "Collaborators" {
     include hpx.browser.ui.interaction with { notes "Required prompts/context/responses are workspace nodes,distinct from contributed content and authorship evidence. Workspace-local machine users use common permissions;inference stays machine-side. Existing panel does not implement chat records,identity or MCP transport." }
    }
    group "Relations" {
     include hpx.browser.ui.investigation with { notes "Present predicates/assertions and observed/declared/inferred provenance without equating tags,claims,adoption,verification or endorsement. Displayed results remain backend-authorised;current panels do not complete general relationship/provenance semantics." }
    }
   }
   group "Bottom toolbar" {
    include hpx.browser.ui.bottom_toolbar
   }
  }
  style * { color primary }
  style element.tag = #planned { color muted; border dashed }
  exclude * -> *
  include * -> * where kind is browser_presentation
  include * -> * where kind is graph_tab_design
  include hpx.browser.ui.contents -> hpx.browser.ui.graph_tab where kind is graph_tab_design with { title "Selected node / view context (planned)" }
  autoLayout LeftRight 120 100 spline
 }
 view c3_browser_functions of hpx.browser.functions {
  title "C3 / Interface functions"
  description "Six existing source-backed responsibility areas, now explicitly viewed as interface functions. Shared app.js rendering/orchestration remains co-located; this is a view grouping, not a new facade. The visible User interface is context outside the boundary. Domain authority, keys and durable workspace state remain Rust-owned. HPX-CAN-014: required HPX-DOM-001 allocation is recorded in view-only notes; current helper coverage is bounded. Precise concepts and unadopted mechanisms remain linked contracts; no conceptual gap is closed by allocation."
  link ../../docs/05-domain/core-object-model.md
  link ../../docs/05-domain/text-and-anchors.md
  link ../../docs/06-subsystems/frontend-interaction.md
  link ../../docs/06-subsystems/interfaces/browser-runtime.md
  link ../../docs/06-subsystems/ai-collaboration.md
  link ../../docs/07-implementation/protocols/draft-publication.md
  link ../audits/browser-interface-c3-audit.md#user-interface-and-interface-functions
  include hpx.browser.ui with { navigateTo c3_browser_ui }
  include hpx.native.transport with { title "Runtime and API" navigateTo c3_runtime_api }
  include os_clipboard, exchange_files
  group "Interface functions" {
   include hpx.browser.shell with { title "Navigation and display coordination" description "Document switching, tree/minimap synchronisation, panel selection and display preferences. Existing app.js coordination; the retained shell responsibility ID is unchanged."  notes "Preserve logical selected document/branch/occurrence context across derived views;display preferences are not canonical graph publication. Navigation publication follows adopted policy,not an implicit Commit on every UI action." }
   include hpx.browser.access with { notes "Authentication/session,workspace unlock and current user permission are distinct. UI state cannot replace backend checks. Workspace-local human/machine identity and permission formats remain unadopted;keys stay Rust-only in current trusted-server scope." }
   include hpx.browser.editor with { notes "Preserve exact UTF8 source/line endings;convert browser UTF16 selections only against exact owned text and reject stale mapping. Anchors bind exact revisions/ranges,not heuristic matches. Current whole-owned-buffer evidence does not enable general multi-owner saves." }
   include hpx.browser.coordination with { notes "Capture exact generation/base/sequence and original operation context. Retain newer typing across delayed/lost ACK,restart and uncertain outcomes;draft save/private checkpoint differ from Commit. Current coordination is bounded evidence,not a complete collaborative protocol." }
   include hpx.browser.history with { title "History, branch and graph operations" description "Client inspection, comparison and branch/graph/audit requests with bounded scope and stale-context checks. Rust retains authorization and durable state."  notes "Request authorised exact historical snapshots/occurrence-path bindings;never silently substitute heads. Same-node ancestry and cross-identity derivation remain distinct. Existing bounded history/branch tools do not resolve full closure or general parent-Merge." }
   include hpx.browser.annotations with { title "Annotation and provenance operations" description "Capture exact context, read protected annotation/provenance state and request reviewed operations. Panel widgets live in User interface; durable acceptance remains Rust-owned."  notes "Capture exact revision/anchor and ordered participant context for reviewed backend operations. Observed exchanges,declared sources,inferred provenance and contributions stay distinct;adoption grants neither authorship nor verification. No browser-side authority or inference service is added." }
  }
  style * { color primary }
  style element.tag = #planned { color muted; border dashed }
  exclude * -> *
  include * -> * where kind is browser_detail
  include hpx.browser.ui -> hpx.browser.shell where kind is browser_presentation
  include hpx.browser.shell -> hpx.browser.ui where kind is browser_presentation
  autoLayout LeftRight 120 100 spline
 }
}
