{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "HPX V3: Live model",
      "type": "shell",
      "command": "npm",
      "args": [
        "--prefix",
        "architecture",
        "run",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "HPX V3: Validate model",
      "type": "shell",
      "command": "npm",
      "args": [
        "--prefix",
        "architecture",
        "run",
        "validate"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "HPX V3: Build navigable site",
      "type": "shell",
      "command": "npm",
      "args": [
        "--prefix",
        "architecture",
        "run",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
