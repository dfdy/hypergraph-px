# Isolated proof translators, nightly/cache files and extraction output.
/.verification/
/shared/tooling/__pycache__/
/shared/tooling/tests/__pycache__/

# Local source/reference material excluded from publication.
/SPECS/
/docs/source-reading-record.md

# Raw frontend exports stay local until reviewed and adapted.
/frontend/incoming/sites-export/*
!/frontend/incoming/sites-export/.gitkeep

# Accepted frontend generated assets and local browser traces.
/frontend/dist/
/frontend/test-results/
/frontend/playwright-report/

# Provenance archives: all payloads stay local; prior publication remains in Git history.
/.provenance/oldspecs/
/.provenance/archive/
/.provenance/public-record/specification-snapshots/

# Defensive exclusions for obsolete archive locations; payloads now live under .provenance/.
/.oldspecs/
/.archive/
/docproject/public-record/specification-snapshots/

# Private per-file source checkpoints for authorized relocation; never publish.
/.provenance/local-reorganisation-checkpoints/

# Relocated locally private owner request dispositions (formerly INPUT.md).
/docs/02-governance/requests.md

# Classified private local evidence,credentials,workspaces,tools and compiler outputs.
/.local/

# Local editor and agent settings.
/.vscode/
/.codex/
/.zed/

# Owner instruction, 2026-11-14: keep all provenance archives local.
/.provenance/
